---
import type { CollectionEntry } from "astro:content";
import config from "@/config/config.json";
import NewsListing from "@/layouts/NewsListing.astro";
import { getNewsPosts } from "@/lib/news";

export async function getStaticPaths() {
  const posts = await getNewsPosts();
  const pageSize = config.settings.pagination;
  const totalPages = Math.ceil(posts.length / pageSize);
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
    const currentPage = index + 2;
    return {
      params: { page: String(currentPage) },
      props: {
        posts: posts.slice(
          (currentPage - 1) * pageSize,
          currentPage * pageSize,
        ),
        currentPage,
        totalPages,
      },
    };
  });
}

interface Props {
  posts: CollectionEntry<"news">[];
  currentPage: number;
  totalPages: number;
}
const { posts, currentPage, totalPages } = Astro.props;
---

<NewsListing posts={posts} currentPage={currentPage} totalPages={totalPages} />
