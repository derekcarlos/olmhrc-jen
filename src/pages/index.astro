---
import HomeWelcome from "@/components/HomeWelcome.astro";
import HomeMinistries from "@/components/HomeMinistries.astro";
import Base from "@/layouts/Base.astro";
import { getListPage } from "@/lib/contentParser.astro";
import { getNewsPosts } from "@/lib/news";
import dateFormat from "@/lib/utils/dateFormat";
import { FaCross, FaRegBell, FaArrowRight } from "react-icons/fa";

const homepage = await getListPage("homepage", "-index");
const { banner, mass, news } = homepage.data;
const latestNews = (await getNewsPosts())[0];
---

<Base>
  <div class="rosarium-home">
    <HomeWelcome banner={banner} />

    <section class="gather-section" aria-label="Chapel life">
      <div class="container chapel-life">
        <article class="life-panel" aria-labelledby="mass-title">
          <span class="section-icon"><FaCross aria-hidden="true" /></span>
          <p class="eyebrow">Together in worship</p>
          <h2 id="mass-title">{mass.title}</h2>
          <p>{mass.content}</p>
          <p>{mass.detail}</p>
          <p class="notice-line">{mass.notice}</p>
          <a class="text-link" href={mass.button.link}
            >{mass.button.label}<FaArrowRight aria-hidden="true" /></a
          >
        </article>
        <article class="life-panel" aria-labelledby="news-title">
          <span class="section-icon"><FaRegBell aria-hidden="true" /></span>
          <p class="eyebrow">News &amp; announcements</p>
          <h2 id="news-title">{news.title}</h2>
          <p>{news.content}</p>
          {
            latestNews ? (
              <div class="latest-news">
                <p class="news-date">
                  <time datetime={latestNews.data.date.toISOString()}>
                    {dateFormat(latestNews.data.date)}
                  </time>
                </p>
                <h3>
                  <a href={`/news/${latestNews.id}`} class="hover:underline">
                    {latestNews.data.title}
                  </a>
                </h3>
                <p>{latestNews.data.description}</p>
                <a class="text-link" href={`/news/${latestNews.id}`}>
                  Read latest news
                  <FaArrowRight aria-hidden="true" />
                </a>
              </div>
            ) : (
              <div class="news-empty">
                <p>{news.notice}</p>
              </div>
            )
          }
          <a class="text-link" href={news.button.link}
            >{news.button.label}<FaArrowRight aria-hidden="true" /></a
          >
        </article>
      </div>
    </section>

    <HomeMinistries />
  </div>
</Base>
<style>
  .rosarium-home {
    --home-accent: var(--color-accent);
  }
  .eyebrow {
    color: var(--home-accent);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-weight: 600;
    margin-bottom: 1rem;
  }
  h2 {
    font-size: clamp(1.85rem, 3vw, 2.65rem);
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
  }
  h3 {
    font-size: 1.7rem;
    margin-bottom: 0.8rem;
  }
  .gather-section {
    border-block: 1px solid var(--color-border);
    background: var(--color-light);
  }
  .chapel-life {
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding-block: 4rem;
  }
  .life-panel {
    padding: 0 4rem 0 1rem;
  }
  .life-panel + .life-panel {
    padding: 0 1rem 0 4rem;
    border-left: 1px solid var(--color-border);
  }
  .section-icon {
    display: inline-flex;
    font-size: 1.4rem;
    color: var(--home-accent);
    margin-bottom: 1.5rem;
  }
  .life-panel > p:not(.eyebrow) {
    margin-bottom: 1rem;
  }
  .notice-line {
    font-size: var(--reading-size);
    border-left: 2px solid var(--home-accent);
    padding-left: 1rem;
    margin-top: 1.5rem;
  }
  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 600;
    color: var(--color-primary);
    padding-block: 0.6rem;
  }
  .text-link :global(svg) {
    width: 0.8rem;
    transition: transform 0.2s;
  }
  .text-link:hover :global(svg) {
    transform: translateX(4px);
  }
  a:focus-visible {
    outline: 2px solid var(--home-accent);
    outline-offset: 5px;
  }
  .news-empty {
    border: 1px dashed var(--color-border);
    border-radius: 0.5rem;
    padding: 1.5rem;
    margin-block: 1.5rem 0.5rem;
    font-size: var(--reading-size);
  }
  .latest-news {
    margin-block: 1.5rem 0.5rem;
    padding-left: 1.25rem;
    border-left: 2px solid var(--home-accent);
  }
  .news-date {
    font-size: 18px;
    margin-bottom: 0.5rem;
  }
  :global(.dark) .rosarium-home {
    --home-accent: var(--color-darkmode-accent);
  }
  :global(.dark) .gather-section {
    background: var(--color-darkmode-light);
  }
  :global(.dark) .gather-section,
  :global(.dark) .life-panel + .life-panel,
  :global(.dark) .news-empty {
    border-color: var(--color-darkmode-border);
  }
  :global(.dark) .text-link {
    color: var(--color-darkmode-primary);
  }
  @media (max-width: 900px) {
    .life-panel {
      padding-right: 2rem;
    }
    .life-panel + .life-panel {
      padding-left: 2rem;
    }
  }
  @media (max-width: 640px) {
    .chapel-life {
      grid-template-columns: 1fr;
    }
    .chapel-life {
      padding-block: 2.5rem;
      gap: 2.5rem;
    }
    .life-panel,
    .life-panel + .life-panel {
      padding: 0;
      border-left: 0;
    }
    .life-panel + .life-panel {
      border-top: 1px solid var(--color-border);
      padding-top: 2.5rem;
    }
  }
</style>
