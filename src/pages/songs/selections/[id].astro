---
import { getChoirLibrary } from "@/lib/songs";
import Base from "@/layouts/Base.astro";
import SelectionRehearsal from "@/components/SelectionRehearsal.astro";
export async function getStaticPaths() {
  const { songs, selections } = await getChoirLibrary();
  return selections.map((selection) => ({
    params: { id: selection.id },
    props: { selection, songs },
  }));
}
const { selection, songs } = Astro.props;
---

<Base
  title={`${selection.title} | Rosarium`}
  description={`Choir rehearsal for ${selection.title}. Lyrics, practice recordings and your personal checklist.`}
>
  <main class="songs-hub container">
    <header class="hub-heading">
      <div>
        <p class="hub-kicker">Rosarium · Choir rehearsal</p><h1>
          Prepare in song.
        </h1><p><a href="/songs">← All song selections</a></p>
      </div>
    </header>
    <SelectionRehearsal selection={selection} songs={songs} />
  </main>
</Base>
<script>
  import { prepareSongsHub } from "@/lib/songs-hub-client";
  prepareSongsHub();
  document.addEventListener("astro:page-load", () => prepareSongsHub());
</script>
