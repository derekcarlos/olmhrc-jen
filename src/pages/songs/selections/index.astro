---
import Base from "@/layouts/Base.astro";
import SelectionCards from "@/components/SelectionCards.astro";
import { getChoirLibrary } from "@/lib/songs";
import "@/styles/songs-hub.css";
const { selections } = await getChoirLibrary();
const summaries = selections.map(({ id, date, status }) => ({
  id,
  date,
  status,
}));
---

<Base
  title="Previous Song Selections | Rosarium"
  description="Previous choir lineups, lyrics and practice recordings."
>
  <main
    class="songs-hub container"
    data-selection-browser
    data-selections={JSON.stringify(summaries)}
  >
    <header class="hub-heading">
      <div>
        <p class="page-eyebrow">Rosarium · Choir archive</p><h1
          class="page-title"
        >
          Sing it again.
        </h1><p><a href="/songs">← This Sunday and future lineups</a></p>
      </div>
    </header>
    <SelectionCards selections={selections} mode="past" />
  </main>
</Base>
<script>
  import { prepareSelectionBrowser } from "@/lib/selection-browser";
  prepareSelectionBrowser();
  document.addEventListener("astro:page-load", () => prepareSelectionBrowser());
</script>
