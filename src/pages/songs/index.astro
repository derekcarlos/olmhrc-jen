---
import Base from "@/layouts/Base.astro";
import SelectionRehearsal from "@/components/SelectionRehearsal.astro";
import SelectionCards from "@/components/SelectionCards.astro";
import { getChoirLibrary } from "@/lib/songs";
import { groupSelections } from "@/lib/selection-dates.mjs";
import { FaArrowRight, FaMusic, FaPrayingHands } from "react-icons/fa";
import "@/styles/songs-hub.css";
const { songs, selections } = await getChoirLibrary();
const grouped = groupSelections(selections);
const countMass = songs.filter(
  (song) => song.data.mass_parts.length > 0,
).length;
const countMarian = songs.filter((song) => song.data.marian).length;
const summaries = selections.map(({ id, date, status }) => ({
  id,
  date,
  status,
}));
---

<Base
  title="Songs | Rosarium"
  description="This Sunday's choir lineup, future celebrations, practice recordings and lyrics."
>
  <main
    class="songs-hub container"
    data-selection-browser
    data-selections={JSON.stringify(summaries)}
    data-base={import.meta.env.BASE_URL}
  >
    <header class="hub-heading">
      <div>
        <p class="hub-kicker">Coro de Rosarium · Choir &amp; Community</p><h1>
          Sunday, in song.
        </h1><p>Your selection. Your practice. Our voices together.</p>
      </div>
      <a class="hub-library-shortcut" href="#choir-library"
        ><strong>{songs.length}</strong><span
          >songs in our<br />growing songbook <FaArrowRight
            aria-hidden="true"
          /></span
        ></a
      >
    </header>

    <nav class="lineup-quick-links" aria-label="Browse choir lineups">
      <a href="#future-lineups-title"
        >Prepare ahead · <span data-lineup-shortcut-count
          >{grouped.future.length}
          {grouped.future.length === 1 ? "lineup" : "lineups"}</span
        > ↓</a
      ><a href="/songs/selections">Previous selections</a>
    </nav>
    <div data-featured-rehearsal data-featured-id={grouped.featured?.id || ""}>
      <SelectionRehearsal selection={grouped.featured} songs={songs} />
    </div>
    <p class="lineup-load-error" data-lineup-error role="status" hidden></p>
    <template data-empty-lineup
      ><SelectionRehearsal selection={null} songs={songs} /></template
    >
    <SelectionCards selections={selections} mode="future" />
    <section
      class="hub-library"
      id="choir-library"
      aria-labelledby="library-title"
    >
      <div class="library-heading">
        <p class="hub-kicker">Keep growing your repertoire</p><h2
          id="library-title"
        >
          Beyond this Sunday
        </h2>
      </div>
      <div class="library-paths">
        <a href="/songs/mass"
          ><FaMusic aria-hidden="true" /><div>
            <span>{countMass} songs</span><h3>Mass repertoire</h3><p>
              Find a setting by Mass part, season, or celebration.
            </p>
          </div><FaArrowRight aria-hidden="true" /></a
        ><a href="/songs/marian"
          ><FaPrayingHands aria-hidden="true" /><div>
            <span
              >{
                countMarian ? `${countMarian} songs` : "No songs added yet"
              }</span
            ><h3>Marian songs</h3><p>
              Our collection for devotion to Our Lady.
            </p>
          </div><FaArrowRight aria-hidden="true" /></a
        >
      </div>
    </section>
    <nav class="hub-archive" aria-label="Previous choir selections">
      <span>Returning to a familiar celebration?</span><a
        href="/songs/selections"
        >Browse past selections <FaArrowRight aria-hidden="true" /></a
      >
    </nav>
  </main>
</Base>
<script>
  import { prepareSongsHub } from "@/lib/songs-hub-client";
  import { prepareSelectionBrowser } from "@/lib/selection-browser";
  function prepare() {
    prepareSongsHub();
    prepareSelectionBrowser();
  }
  prepare();
  document.addEventListener("astro:page-load", prepare);
</script>
