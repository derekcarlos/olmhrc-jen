---
import {
  getChoirLibrary,
  defaultSongSelection,
  selectionSongTracks,
} from "@/lib/songs";
import SongPractice from "@/components/SongPractice.astro";
export async function getStaticPaths() {
  const { songs, selections, songMap } = await getChoirLibrary();
  return songs.map((song) => {
    const selection = defaultSongSelection(selections, song.id);
    return {
      params: { slug: song.id },
      props: {
        song,
        selection,
        tracks: selectionSongTracks(selection, songMap),
      },
    };
  });
}
---

<SongPractice {...Astro.props} />
