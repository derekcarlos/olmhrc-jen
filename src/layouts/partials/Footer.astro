---
import Logo from "@/components/Logo.astro";
import Social from "@/components/Social.astro";
import config from "@/config/config.json";
import menu from "@/config/menu.json";
import social from "@/config/social.json";
import { markdownify } from "@/lib/utils/textConverter";
import { footerNavigation, navigationCurrent } from "@/lib/navigation.mjs";
import {
  LuArrowUp,
  LuArrowUpRight,
  LuBookOpen,
  LuChurch,
} from "react-icons/lu";
const links = footerNavigation(menu.main);
const { pathname } = Astro.url;
---

<footer class="chapel-footer" aria-labelledby="footer-invitation-title">
  <div class="container">
    <section class="footer-invitation">
      <div>
        <p class="footer-eyebrow">Faith · Prayer · Community</p>
        <h2 id="footer-invitation-title">See you at the chapel.</h2>
        <p class="footer-welcome">
          Join our community for Mass, or make a little room for prayer wherever
          you are.
        </p>
      </div>
      <nav class="footer-next-steps" aria-label="Ways to join in">
        <a href="/mass"
          ><LuChurch size={25} aria-hidden="true" /><span
            ><strong>Come to Mass</strong><span>Times and celebrations</span
            ></span
          ><LuArrowUpRight size={21} aria-hidden="true" /></a
        >
        <a href="/prayers"
          ><LuBookOpen size={25} aria-hidden="true" /><span
            ><strong>A moment for prayer</strong><span
              >A guide at every step</span
            ></span
          ><LuArrowUpRight size={21} aria-hidden="true" /></a
        >
      </nav>
    </section>

    <div class="footer-sitemap">
      <div class="footer-identity">
        <Logo
          src={config.site.logo_darkmode}
          srcDarkmode={config.site.logo_darkmode}
        />
        <p>Faith, prayer, and community<br />in Jubilation Enclave North.</p>
        {
          social.main.length > 0 && (
            <Social source={social.main} className="social-icons" />
          )
        }
      </div>
      <nav aria-labelledby="footer-chapel-title">
        <h3 id="footer-chapel-title">Chapel life</h3>
        <ul>
          {
            links.chapel.map((link) => (
              <li>
                <a
                  href={link.url}
                  aria-current={navigationCurrent(pathname, link.url)}
                >
                  {link.name}
                  <LuArrowUpRight size={16} aria-hidden="true" />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <nav aria-labelledby="footer-prayer-title">
        <h3 id="footer-prayer-title">Pray with us</h3>
        <ul>
          {
            links.prayer.map((link) => (
              <li>
                <a
                  href={link.url}
                  aria-current={navigationCurrent(pathname, link.url)}
                >
                  {link.name}
                  <LuArrowUpRight size={16} aria-hidden="true" />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="footer-signoff">
      <p set:html={markdownify(config.params.copyright)} />
      <a class="back-to-top" href="#top"
        >Back to top <span><LuArrowUp size={19} aria-hidden="true" /></span></a
      >
    </div>
  </div>
</footer>

<style>
  .chapel-footer {
    background: #163d53;
    color: #fff9ed;
    border-top: 4px solid #d9bd86;
  }
  .chapel-footer a {
    text-decoration: none;
  }
  .chapel-footer a:focus-visible {
    outline: 3px solid #e7cf9b;
    outline-offset: 5px;
    border-radius: 0.2rem;
  }
  .footer-invitation {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 3rem;
    align-items: center;
    padding-block: clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid #527184;
  }
  .footer-eyebrow {
    color: #e7cf9b;
    font-size: 13px;
    line-height: 1.6;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0 0 1rem;
  }
  .footer-invitation h2 {
    color: #fff9ed;
    font-family: var(--font-secondary);
    font-size: clamp(36px, 4.5vw, 60px);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
    text-wrap: balance;
  }
  .footer-welcome {
    color: #d3e1e7;
    font-size: 20px;
    line-height: 1.6;
    max-width: 43ch;
    margin: 0;
  }
  .footer-next-steps {
    display: grid;
    gap: 0.75rem;
  }
  .footer-next-steps a {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr) 22px;
    gap: 1rem;
    align-items: center;
    padding: 1rem 1.25rem;
    border: 1px solid #668494;
    border-radius: 0.5rem;
    color: #e7cf9b;
    background: rgb(255 255 255 / 3%);
    transition:
      background-color 160ms,
      border-color 160ms;
  }
  .footer-next-steps a:hover {
    background: #214e65;
    border-color: #d9bd86;
  }
  .footer-next-steps a > span {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .footer-next-steps strong {
    color: #fff9ed;
    font-family: var(--font-secondary);
    font-size: 28px;
    line-height: 1.2;
    font-weight: 400;
  }
  .footer-next-steps a > span > span {
    color: #c2d2da;
    font-size: 15px;
    line-height: 1.5;
  }
  .footer-sitemap {
    display: grid;
    grid-template-columns: 1.2fr 0.5fr 0.5fr;
    gap: clamp(2rem, 5vw, 5rem);
    padding-block: 2.75rem;
  }
  .footer-identity {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }
  .footer-identity p {
    color: #d3e1e7;
    font-size: 18px;
    line-height: 1.6;
    margin: 0;
  }
  .footer-sitemap h3 {
    font-family: var(--font-primary);
    color: #e7cf9b;
    font-size: 13px;
    line-height: 1.6;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0 0 0.8rem;
  }
  .footer-sitemap ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .footer-sitemap li {
    margin: 0;
  }
  .footer-sitemap nav a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    color: #e5edf0;
    font-size: 18px;
    line-height: 1.5;
    min-height: 44px;
    padding: 0.45rem 0;
  }
  .footer-sitemap nav a :global(svg) {
    opacity: 0;
    color: #e7cf9b;
    transition: opacity 150ms;
  }
  .footer-sitemap nav a:hover,
  .footer-sitemap nav a[aria-current] {
    color: #e7cf9b;
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 1px;
  }
  .footer-sitemap nav a:hover :global(svg),
  .footer-sitemap nav a:focus-visible :global(svg),
  .footer-sitemap nav a[aria-current] :global(svg) {
    opacity: 1;
  }
  .footer-signoff {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 1.5rem;
    border-top: 1px solid #527184;
  }
  .footer-signoff > p {
    color: #c2d2da;
    font-size: 14px;
    line-height: 1.7;
    margin: 0;
  }
  .back-to-top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: #e5edf0;
    font-size: 15px;
    min-height: 44px;
    flex-shrink: 0;
  }
  .back-to-top > span {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid #668494;
    color: #e7cf9b;
  }
  .back-to-top:hover > span {
    background: #f0ddb4;
    color: #17374a;
    border-color: #f0ddb4;
  }
  @media (max-width: 900px) {
    .footer-invitation {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.75rem;
    }
    .footer-next-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .footer-next-steps a {
      grid-template-columns: minmax(0, 1fr) 20px;
      gap: 0.75rem;
    }
    .footer-next-steps a > :global(svg:first-child) {
      grid-column: 1 / -1;
    }
    .footer-next-steps strong {
      font-size: 26px;
    }
    .footer-sitemap {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem;
    }
    .footer-identity {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 540px) {
    .footer-next-steps {
      grid-template-columns: minmax(0, 1fr);
    }
    .footer-next-steps a {
      grid-template-columns: 28px minmax(0, 1fr) 22px;
    }
    .footer-next-steps a > :global(svg:first-child) {
      grid-column: auto;
    }
    .footer-signoff {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .chapel-footer a,
    .chapel-footer :global(svg) {
      transition: none;
    }
  }
</style>
