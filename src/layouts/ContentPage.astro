---
import ImageMod from "@/components/ImageMod.astro";
import Base from "@/layouts/Base.astro";
import { markdownify } from "@/lib/utils/textConverter";

interface Props {
  title: string;
  meta_title?: string;
  description?: string;
  image?: string;
  eyebrow?: string;
  titleSize?: "h1" | "h3";
  wide?: boolean;
  compactHeader?: boolean;
}

const {
  title,
  meta_title,
  description,
  image,
  wide = false,
  compactHeader = false,
} = Astro.props;
const section = Astro.url.pathname.split("/").filter(Boolean)[0] || "";
const labels: Record<string, string> = {
  about: "Faith · Prayer · Community",
  mass: "Together in worship",
  calendar: "Life at our chapel",
  prayers: "A moment for prayer",
  readings: "Ang Salita ng Diyos",
  news: "From our chapel community",
  songs: "Coro de Rosarium · The songbook",
};
const eyebrow =
  Astro.props.eyebrow || labels[section] || "Rosarium · Our chapel";
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
>
  <section
    class:list={[
      "section-sm",
      "content-page",
      compactHeader && "content-page-compact",
    ]}
  >
    <div
      class="container"
      style={compactHeader ? "max-width: 1224px !important" : undefined}
    >
      <div class="row justify-center">
        <div class:list={[wide ? "col-12" : "md:col-10 lg:col-8"]}>
          <header class="page-heading">
            <p class="page-eyebrow">{eyebrow}</p>
            <h1 set:html={markdownify(title)} class="page-title" />
          </header>
          {
            image && (
              <ImageMod
                class="mx-auto mb-6 rounded"
                src={image}
                width={1200}
                height={600}
                alt={title}
                format="webp"
              />
            )
          }
          <slot />
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .content-page {
    padding-top: var(--page-top-gap);
  }
  .page-heading {
    margin-bottom: 1.5rem;
  }
  .content-page-compact :global(.content > p:first-child) {
    margin-top: 0;
    margin-bottom: 0;
  }
</style>
