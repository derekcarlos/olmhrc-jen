---
import config from "@/config/config.json";
import { resolveSocialImage } from "@/lib/social-preview.mjs";
import theme from "@/config/theme.json";
import { plainify } from "@/lib/utils/textConverter";
import Footer from "@/partials/Footer.astro";
import Header from "@/partials/Header.astro";
import "@/styles/main.css";
import {
  GoogleTagmanager,
  GoogleTagmanagerNoscript,
} from "@digi4care/astro-google-tagmanager";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import Announcement from "./helpers/Announcement";
import SiteSearch from "@/components/SiteSearch.astro";

// font families - extract font names for Font component (filter out type keys)
const fontEntries = Object.entries(theme.fonts.font_family).filter(
  ([key]) => !key.includes("_type"),
);

// types for frontmatters
export interface Props {
  title?: string;
  meta_title?: string;
  description?: string;
  image?: string;
  image_alt?: string;
  noindex?: boolean;
  canonical?: string;
}

// destructure frontmatter
const { title, meta_title, description, image, image_alt, noindex, canonical } =
  Astro.props;
const shareImage = resolveSocialImage({
  image: image || config.metadata.meta_image,
  alt: image_alt,
  baseUrl: config.site.base_url,
});
const pageUrl = new URL(Astro.url.pathname, config.site.base_url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- google tag manager -->
    {
      config.google_tag_manager.enable && (
        <GoogleTagmanager id={config.google_tag_manager.gtm_id} />
      )
    }
    <!-- favicon -->
    <link rel="shortcut icon" href={config.site.favicon} />
    <!-- theme meta -->
    <meta name="theme-name" content="astroplate" />
    <meta name="msapplication-TileColor" content="#000000" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#fff"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#000"
    />
    <meta name="generator" content={Astro.generator} />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />

    <!-- google font css - Astro 6 built-in Font API -->
    {
      fontEntries.map(([key]) => {
        const cssVar = `--font-${key}` as any;
        return (
          <Font
            cssVariable={cssVar}
            preload={
              key !== "readings" ||
              /\/readings(?:\/|$)/.test(Astro.url.pathname) ||
              /\/prayers\/how-to-pray-the-holy-rosary\/?$/.test(
                Astro.url.pathname,
              )
            }
          />
        );
      })
    }

    <!-- responsive meta -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=5"
    />

    <!-- title -->
    <title>
      {plainify(meta_title ? meta_title : title ? title : config.site.title)}
    </title>

    <!-- canonical url -->
    {canonical && <link rel="canonical" href={canonical} item-prop="url" />}

    <!-- noindex robots -->
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- meta-description -->
    <meta
      name="description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />

    <ClientRouter />

    <!-- author from config.json -->
    <meta name="author" content={config.metadata.meta_author} />

    <!-- og-title -->
    <meta
      property="og:title"
      content={plainify(
        meta_title ? meta_title : title ? title : config.site.title,
      )}
    />

    <!-- og-description -->
    <meta
      property="og:description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={config.site.title} />
    <meta property="og:url" content={pageUrl} />

    <!-- twitter-title -->
    <meta
      name="twitter:title"
      content={plainify(
        meta_title ? meta_title : title ? title : config.site.title,
      )}
    />

    <!-- twitter-description -->
    <meta
      name="twitter:description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />

    <!-- og-image -->
    <meta property="og:image" content={shareImage.url} />
    {
      shareImage.url.startsWith("https:") && (
        <meta property="og:image:secure_url" content={shareImage.url} />
      )
    }
    {
      shareImage.type && (
        <meta property="og:image:type" content={shareImage.type} />
      )
    }
    {
      shareImage.width && (
        <meta property="og:image:width" content={String(shareImage.width)} />
      )
    }
    {
      shareImage.height && (
        <meta property="og:image:height" content={String(shareImage.height)} />
      )
    }
    <meta property="og:image:alt" content={shareImage.alt} />

    <!-- twitter-image -->
    <meta name="twitter:image" content={shareImage.url} />
    <meta name="twitter:image:alt" content={shareImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body id="top" class="flex flex-col min-h-screen">
    {/* google tag manager noscript */}
    {
      config.google_tag_manager.enable && (
        <GoogleTagmanagerNoscript id={config.google_tag_manager.gtm_id} />
      )
    }
    <Announcement client:only="react" />
    <Header />
    {config.settings.search && <SiteSearch />}
    <main class="grow" id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
