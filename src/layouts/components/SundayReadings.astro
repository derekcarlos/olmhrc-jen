---
import "@/styles/readings.css";
import { formatReadingDate, sundayDate } from "@/lib/readings.mjs";
import type { ReadingSnapshot, ReadingMass } from "@/lib/readings.mjs";
import ReadingMassView from "@/components/ReadingMass.astro";
import ReadingCelebrationTiles from "@/components/ReadingCelebrationTiles.astro";
import { readingChoice, readingGroup } from "@/lib/reading-selection.mjs";
import { manilaToday } from "@/lib/calendar.mjs";
interface Props {
  snapshot: ReadingSnapshot;
  date?: string;
  fixed?: boolean;
  celebrationName?: string;
  calendar?: { date: string; id: string; name: string; category: string }[];
}
const {
  snapshot,
  date,
  fixed = false,
  celebrationName,
  calendar = [],
} = Astro.props;
const selected =
  date ||
  (snapshot.mode === "upcoming-celebrations" ? readingChoice(calendar)?.date || snapshot.dates[0] : snapshot.mode === "next-celebration" ? snapshot.dates[0] : sundayDate());
const record = snapshot.records.find((r) => r.date === selected);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const readingUrl = (day: string) => `${base}/readings/${day}`;
const isEntry = !date;
const masses: ReadingMass[] =
  record?.masses ||
  (record
    ? [
        {
          id: "main",
          label: record.celebration,
          source_url: record.source_url,
          source_date: record.source_date || record.date,
          sections: record.sections,
        },
      ]
    : []);
const selectedMass = record?.selected_mass || masses[0]?.id;
const tiles = readingGroup(calendar, selected).filter((day: (typeof calendar)[number]) => date || day.date >= manilaToday());
---

<div
  class="sunday-readings"
  lang="fil"
  data-readings
  data-fixed={String(fixed)}
  data-calendar-dates={JSON.stringify(snapshot.calendar_dates || [])}
  data-reading-calendar={JSON.stringify(calendar)}
  data-liturgical-id={calendar.find(day => day.date === selected)?.id || ""}
  data-selected-mass={selectedMass}
  data-selected={selected}
  data-entry={String(isEntry)}
  data-dates={JSON.stringify(snapshot.dates)}
  data-available={JSON.stringify(snapshot.records.map((r) => r.date))}
  data-mode={snapshot.mode}
  data-base={base}
>
  <p class="reading-intro">
    Makinig, magnilay, at maghanda para sa pagdiriwang ng Banal na Misa.
  </p>
  <ReadingCelebrationTiles days={tiles} selected={selected} />
  <div class="reading-window">
    <span
      >{
        fixed
          ? "Mga pagbasa para sa pagdiriwang na ito"
          : snapshot.mode === "next-celebration"
            ? "Mga pagbasa para sa darating na pagdiriwang"
            : snapshot.mode === "upcoming-celebrations"
              ? "Mga pagbasa para sa darating na pagdiriwang"
            : snapshot.mode === "next-seven-days"
              ? "Mga pagbasa sa susunod na 7 araw"
              : "Mga pagbasa para sa darating na Linggo"
      }</span
    >
    <a
      href={`${base}/readings`}
      aria-label="Bumalik sa napiling darating na pagdiriwang">{snapshot.mode === "upcoming-celebrations" ? "Para sa ngayon" : "Linggong Ito"}</a
    >
  </div>
  {
    snapshot.mode === "next-seven-days" && (
      <nav class="reading-dates" aria-label="Pumili ng araw">
        {snapshot.dates.map((day) => (
          <a
            href={readingUrl(day)}
            data-reading-day={day}
            aria-current={day === selected ? "date" : undefined}
          >
            <span>{formatReadingDate(day)}</span>
            {!snapshot.records.some((r) => r.date === day) && (
              <small>Hindi pa available</small>
            )}
          </a>
        ))}
      </nav>
    )
  }
  <div class="reading-notice" data-readings-stale role="status" hidden>
    <p data-readings-stale-text>
      Hindi pa available ang mga pagbasa para sa kasalukuyang petsa. Subukang
      muli mamaya.
    </p>
    <a href="https://www.awitatpapuri.com/">Bisitahin ang Awit at Papuri →</a>
  </div>
  <div data-readings-content>
    {masses.length > 1 && <nav class="reading-mass-buttons" data-reading-mass-picker aria-label="Pumili ng Misa">
      {masses.map(mass => <a data-reading-mass-choice={mass.id} aria-current={mass.id === selectedMass ? "true" : undefined} href={`${readingUrl(selected)}?mass=${mass.id}#${mass.id === selectedMass ? "" : `${mass.id}-`}reading-guide`}>{mass.display_label || mass.label}</a>)}
    </nav>}
    <header class="reading-header">
      <p class="reading-banner-label">Liturhiya ng Salita</p>
      <p class="reading-date">
        <time datetime={selected}>{formatReadingDate(selected)}</time>
      </p>
      {
        (record || celebrationName) && (
          <h2 class="reading-celebration">
            {record?.celebration || celebrationName}
          </h2>
        )
      }
      <p class="reading-mass-context" data-reading-context hidden></p>
    </header>
    {
      record ? (
        <>
          {masses.map((mass) => (
            <div data-reading-mass={mass.id} data-mass-reading-date={mass.reading_date || selected} data-mass-context={mass.context || ""}>
              {masses.length > 1 && (
                <h2 class="reading-mass-title">
                  {mass.display_label || mass.label}
                </h2>
              )}
              {mass.reading_date && mass.reading_date !== selected && <noscript><p class="reading-date-note">Anticipated Mass · Mga pagbasa para sa {formatReadingDate(mass.reading_date)}</p></noscript>}
              <ReadingMassView
                record={record}
                mass={mass}
                prefix={mass.id === selectedMass ? "" : `${mass.id}-`}
              />
            </div>
          ))}
        </>
      ) : (
        <div class="reading-notice">
          <p>
            Hindi pa available ang mga pagbasa para sa araw na ito. Mangyaring
            bumalik muli.
          </p>
          <a href="https://www.awitatpapuri.com/">
            Basahin sa Awit at Papuri →
          </a>
        </div>
      )
    }
  </div>
  {
    isEntry && (
      <noscript>
        <p class="reading-source">
          Ang petsang nasa itaas ay pinili noong huling pag-update ng site.{" "}
          <a href="https://www.awitatpapuri.com/">
            Tingnan ang pinakabagong mga pagbasa sa Awit at Papuri.
          </a>
        </p>
      </noscript>
    )
  }
</div>

<script>
  import { prepareReadings } from "@/lib/readings-client";
  prepareReadings();
  document.addEventListener("astro:page-load", prepareReadings);
</script>
