---
const days = [
  ["Unang", "Setyembre 28"],
  ["Ikalawang", "Setyembre 29"],
  ["Ikatlong", "Setyembre 30"],
  ["Ikaapat na", "Oktubre 1"],
  ["Ikalimang", "Oktubre 2"],
  ["Ikaanim na", "Oktubre 3"],
  ["Ikapitong", "Oktubre 4"],
  ["Ikawalong", "Oktubre 5"],
  ["Ikasiyam na", "Oktubre 6"],
];
const sections = [
  ["mga-pambungad-na-panalangin", "Mga pambungad na panalangin"],
  ["panalangin-sa-araw-araw", "Panalangin sa araw-araw"],
  ["panalangin-sa-bawat-araw", "Panalangin sa bawat araw"],
  ["mga-misteryo-ng-santo-rosaryo", "Mga misteryo"],
  ["pagkatapos-ng-mga-misteryo", "Pagkatapos ng mga misteryo"],
  ["ang-litanya-ng-mahal-na-birhen", "Litanya ng Mahal na Birhen"],
  ["dalit", "Dalit"],
  ["pangwakas-na-panalangin-sa-araw-araw", "Pangwakas na panalangin"],
];
---

<novena-guide class="novena-guide" lang="fil">
  <section class="novena-journey" aria-labelledby="novena-journey-title">
    <div class="journey-heading">
      <div>
        <p class="journey-eyebrow">Setyembre 28 — Oktubre 6</p>
        <h2 id="novena-journey-title">Siyam na araw. Isang pamayanan.</h2>
        <p>
          Piliin ang araw. Kasama ang lahat ng panalangin at ang panalangin para
          sa araw na iyon.
        </p>
      </div>
      <a class="novena-pdf" href="/documents/pagsisiyam-santo-rosaryo.pdf"
        >Orihinal na aklat <span aria-hidden="true">↗</span><span
          class="pdf-label">PDF</span
        ></a
      >
    </div>
    <nav class="novena-days" aria-label="Piliin ang araw ng pagsisiyam">
      {
        days.map(([ordinal, label], index) => (
          <a
            href={`#araw-${index + 1}`}
            data-novena-day={index + 1}
            aria-label={`${ordinal} araw — ${label}`}
          >
            <span class="journey-day-label">Araw</span>
            <strong>{index + 1}</strong>
            <span class="journey-date">{label}</span>
          </a>
        ))
      }
    </nav>
    <p class="novena-selection" data-novena-status role="status" hidden></p>
  </section>

  <div class="novena-workspace">
    <aside class="novena-index">
      <p class="page-eyebrow">Gabay sa panalangin</p>
      <nav aria-label="Mga bahagi ng pagsisiyam">
        {
          sections.map(([id, title], index) => (
            <a href={`#${id}`}>
              <span aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              {title}
            </a>
          ))
        }
      </nav>
      <p class="index-invitation">Kasama si Maria,<br />lumapit kay Hesus.</p>
    </aside>
    <div class="novena-prayers"><slot /></div>
  </div>
</novena-guide>

<script>
  import { prepareNovenaGuide } from "@/lib/novena-guide-client";
  class NovenaGuide extends HTMLElement {
    private cleanup?: () => void;
    connectedCallback() {
      this.cleanup = prepareNovenaGuide(this);
    }
    disconnectedCallback() {
      this.cleanup?.();
    }
  }
  if (!customElements.get("novena-guide"))
    customElements.define("novena-guide", NovenaGuide);
</script>

<style>
  .novena-guide {
    --novena-ink: var(--color-text-dark);
    --novena-paper: #fffefb;
    --novena-line: var(--color-border);
    --novena-wash: var(--color-light);
    --novena-gold: var(--color-accent);
    --novena-rubric: #a3413b;
    display: block;
    color: var(--novena-ink);
  }
  :global(.dark) .novena-guide {
    --novena-ink: var(--color-darkmode-text-dark);
    --novena-paper: #1c2933;
    --novena-line: var(--color-darkmode-border);
    --novena-wash: var(--color-darkmode-light);
    --novena-gold: var(--color-darkmode-accent);
    --novena-rubric: #eca69e;
  }
  .novena-guide a:focus-visible {
    outline: 3px solid var(--novena-gold);
    outline-offset: 4px;
  }
  .novena-guide :global([hidden]) {
    display: none !important;
  }
  .novena-selection {
    color: #e7cf9b;
    font-size: 16px;
    margin-top: 1rem;
    line-height: 1.5;
  }
  .novena-prayers {
    scroll-margin-top: 8rem;
  }
  .novena-guide[data-filtered] :global(#panalangin-sa-bawat-araw + p) {
    display: none;
  }
  .novena-prayers :global(section.novena-day-reading) {
    border: 1px solid var(--novena-line);
    border-left: 3px solid var(--novena-gold);
    background: var(--novena-wash);
    padding: 1.25rem;
    margin-block: 1.5rem;
  }
  .novena-prayers :global(.novena-day-reading > h3) {
    margin-top: 0;
    color: var(--novena-gold);
  }
  .novena-prayers :global(.novena-day-reading > :last-child) {
    margin-bottom: 0;
  }
  .novena-journey {
    background: #163d53;
    color: #fff9ed;
    border-radius: 0.75rem;
    padding: clamp(1.25rem, 3vw, 2.5rem);
    border-top: 4px solid #d9bd86;
  }
  .journey-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
  }
  .journey-eyebrow {
    color: #e7cf9b;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }
  .journey-heading h2 {
    color: inherit;
    font-size: clamp(30px, 3vw, 42px);
    font-weight: 400;
    line-height: 1.15;
    margin-bottom: 0.75rem;
  }
  .journey-heading > div > p:last-child {
    color: #d3e1e7;
    font-size: 18px;
    line-height: 1.5;
  }
  .novena-pdf {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    flex-shrink: 0;
    font-size: 16px;
    padding-block: 0.5rem;
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .pdf-label {
    border: 1px solid #718c9a;
    border-radius: 0.2rem;
    padding: 0.1rem 0.3rem;
    font-size: 11px;
    line-height: 1.5;
  }
  .novena-days {
    display: grid;
    grid-template-columns: repeat(9, minmax(0, 1fr));
    gap: 0.6rem;
    margin-top: 2rem;
  }
  .novena-days a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    padding: 0.75rem 0.25rem;
    border: 1px solid #668494;
    border-radius: 0.4rem;
    text-align: center;
    color: #fff9ed;
    transition:
      background-color 150ms,
      color 150ms;
  }
  .novena-days a:hover,
  .novena-days a[aria-current] {
    color: #17374a;
    background: #f0ddb4;
    border-color: #f0ddb4;
  }
  .novena-days a:focus-visible {
    outline-color: #e7cf9b;
  }
  .journey-day-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .novena-days strong {
    font-family: var(--font-secondary);
    font-size: 38px;
    font-weight: 400;
    line-height: 1.1;
  }
  .journey-date {
    font-size: 13px;
    line-height: 1.5;
  }
  .novena-workspace {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
    margin-top: 2rem;
  }
  .novena-index {
    position: sticky;
    top: 7rem;
    padding-top: 1rem;
  }
  .novena-index nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .novena-index nav a {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    font-size: 16px;
    line-height: 1.5;
    padding: 0.65rem 0.5rem;
    border-radius: 0.25rem;
  }
  .novena-index nav a:hover {
    background: var(--novena-wash);
  }
  .novena-index nav a span {
    color: var(--novena-gold);
    font-size: 12px;
    font-weight: 600;
  }
  .index-invitation {
    font-family: var(--font-secondary);
    font-size: 29px;
    line-height: 1.25;
    border-top: 1px solid var(--novena-line);
    padding-top: 1.5rem;
    margin-top: 1.5rem;
  }
  .novena-prayers {
    min-width: 0;
    background: var(--novena-paper);
    border: 1px solid var(--novena-line);
    border-radius: 0.75rem;
    padding: clamp(1.25rem, 3vw, 3rem);
  }
  .novena-prayers :global(.content) {
    color: var(--novena-ink);
  }
  .novena-prayers :global(em),
  .novena-prayers :global(em a) {
    color: var(--novena-rubric);
  }
  .novena-prayers :global(#mga-bahagi),
  .novena-prayers :global(#mga-bahagi + ul) {
    display: none;
  }
  .novena-prayers :global(h2) {
    font-weight: 400;
    font-size: 34px;
    padding-top: 1.25rem;
    border-top: 1px solid var(--novena-line);
  }
  .novena-prayers :global(h3) {
    font-weight: 400;
  }
  .novena-prayers :global(details.novena-day) {
    border-color: var(--novena-line);
    background: var(--novena-wash);
    padding: 0;
    overflow: clip;
  }
  .novena-prayers :global(details.novena-day > summary) {
    color: var(--novena-ink);
    padding: 1rem 1.25rem;
    font-weight: 500;
  }
  .novena-prayers :global(details.novena-day[open] > summary) {
    color: var(--novena-gold);
    border-bottom: 1px solid var(--novena-line);
    margin-bottom: 1rem;
  }
  .novena-prayers :global(details.novena-day > :not(summary)) {
    margin-inline: 1.25rem;
  }
  .novena-prayers :global(details.novena-day > :last-child) {
    margin-bottom: 1.25rem;
  }
  .novena-prayers :global(details.novena-day:target) {
    outline: 2px solid var(--novena-gold);
    outline-offset: 4px;
  }
  @media (max-width: 900px) {
    .journey-heading {
      flex-direction: column;
      gap: 0.75rem;
    }
    .novena-days {
      display: flex;
      overflow-x: auto;
      padding: 0.25rem 0.25rem 0.75rem;
      margin-top: 1.25rem;
      scroll-snap-type: x proximity;
    }
    .novena-days a {
      flex: 0 0 100px;
      scroll-snap-align: start;
    }
    .novena-workspace {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }
    .novena-index {
      position: static;
      min-width: 0;
      padding-top: 0;
    }
    .novena-index nav {
      flex-direction: row;
      overflow-x: auto;
      padding-bottom: 0.75rem;
    }
    .novena-index nav a {
      flex: 0 0 auto;
      border: 1px solid var(--novena-line);
    }
    .index-invitation {
      display: none;
    }
    .novena-prayers :global(h2) {
      font-size: 30px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .novena-days a {
      transition: none;
    }
  }
</style>
