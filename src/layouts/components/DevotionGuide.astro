---
import catalog from "@/data/rosary-tl.json";
import { novenaDays, novenaPhases } from "@/lib/novena-walkthrough-client";
interface Props {
  devotion?: "flores" | "novena";
}
const { devotion = "flores" } = Astro.props;
const isNovena = devotion === "novena";
const floresPhases = [
  ["opening", "Mga pambungad na panalangin"],
  ["daily", "Pagninilay sa araw"],
  ["petitions", "Mga pagdulog"],
  ["offering", "Pag-aalay ng bulaklak"],
  ["family", "Pagtatalaga ng pamilya"],
  ["closing", "Pangwakas na awit"],
];

const phases = isNovena ? novenaPhases : floresPhases;
const days = isNovena
  ? novenaDays
  : Array.from({ length: 31 }, (_, index) => `Mayo ${index + 1}`);
---

<devotion-guide class="flores-guide" lang="tl" data-devotion={devotion}>
  <section class="flores-invitation" aria-labelledby="flores-invitation-title">
    <p class="invitation-eyebrow">
      {
        isNovena
          ? "Setyembre 28 — Oktubre 6 · Pagsisiyam"
          : "Mayo 1 — 31 · Kasama si Maria"
      }
    </p>
    <h2 id="flores-invitation-title">
      {isNovena ? "Siyam na araw." : "Isang panalangin."}<br />{
        isNovena ? "Isang pamayanan." : "Isang paghahandog."
      }
    </h2>
    <p>
      {
        isNovena
          ? "Sundan ang pagsisiyam sa Mahal na Birhen ng Santo Rosaryo. Piliin ang araw at manalangin kasama ang ating pamayanan, isang panalangin sa bawat hakbang."
          : "Parangalan ang Mahal na Birheng Maria sa buong buwan ng Mayo. Sundan ang mga panalangin at pagninilay, sa sarili mong bilis."
      }
    </p>
    {
      !isNovena && (
        <div class="day-choice">
          <label for="flores-day">
            {isNovena
              ? "Piliin ang araw ng pagsisiyam"
              : "Piliin ang araw ng Mayo"}
          </label>
          <select id="flores-day" data-flores-day>
            {days.map((label, index) => (
              <option value={index + 1}>{label}</option>
            ))}
          </select>
          <p>
            {isNovena
              ? "Kasama ang mga karaniwang panalangin, ang panalangin para sa napiling araw, at ang Santo Rosaryo."
              : "Kasama ang pagninilay, panalangin, at paghahandog para sa araw na ito."}
          </p>
        </div>
      )
    }
    {
      isNovena && (
        <Fragment>
          <section class="tile-choice" aria-labelledby="novena-days-label">
            <h3 id="novena-days-label">Piliin ang araw ng pagsisiyam</h3>
            <div class="novena-date-tiles">
              {novenaDays.map((label, index) => (
                <button
                  type="button"
                  data-flores-day-choice={index + 1}
                  aria-label={label}
                  aria-pressed="false"
                >
                  <span class="tile-eyebrow">Araw</span>
                  <strong>{index + 1}</strong>
                  <span class="tile-date">{label.split(" — ")[1]}</span>
                </button>
              ))}
            </div>
          </section>
          <section class="tile-choice" aria-labelledby="novena-mysteries-label">
            <h3 id="novena-mysteries-label">Piliin ang mga misteryo</h3>
            <div class="novena-mystery-tiles">
              {catalog.mysteries.map((set, index) => (
                <button
                  type="button"
                  data-flores-mystery-choice={set.id}
                  aria-pressed="false"
                >
                  <span class="tile-eyebrow">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <strong>{set.title.replace("Mga Misteryo ng ", "")}</strong>
                  <span class="tile-date">{set.days}</span>
                </button>
              ))}
            </div>
            <p>
              Ang mungkahing misteryo ay ayon sa napiling petsa ng pagsisiyam.
              Maaari ring pumili ng ibang pangkat.
            </p>
          </section>
          <a
            class="booklet-link"
            href="/documents/pagsisiyam-santo-rosaryo.pdf"
          >
            Orihinal na aklat · PDF ↗
          </a>
        </Fragment>
      )
    }
  </section>

  <div class="flores-workspace" data-flores-workspace hidden>
    <aside class="flores-route">
      <p class="page-eyebrow">Gabay sa panalangin</p>
      <nav
        aria-label={isNovena
          ? "Mga bahagi ng pagsisiyam"
          : "Mga bahagi ng Flores de Maria"}
      >
        {
          phases.map(([id, title], index) => (
            <Fragment>
              <button type="button" data-flores-phase={id}>
                <span class="route-number" aria-hidden="true">
                  {index + 1}
                </span>
                <span>{title}</span>
              </button>
              {isNovena && id === "mysteries" && (
                <div
                  class="mystery-shortcuts"
                  role="group"
                  aria-label="Pumunta sa isang misteryo"
                >
                  {Array.from({ length: 5 }, (_, mystery) => (
                    <button
                      type="button"
                      data-flores-mystery-step={mystery}
                      aria-label={`Misteryo ${mystery + 1}`}
                    >
                      {mystery + 1}
                    </button>
                  ))}
                </div>
              )}
            </Fragment>
          ))
        }
      </nav>
      <p class="route-note">
        Ang mga tagubilin ay nasa pula.<br />Dasalin ang mga panalangin sa
        malaking teksto.
      </p>
      <button class="restart-prayer" type="button" data-flores-action="restart"
        >Magsimula muli</button
      >
    </aside>

    <article
      class="flores-panel"
      data-flores-panel
      tabindex="-1"
      aria-labelledby="flores-prayer-title"
    >
      <header class="panel-header">
        <p class="page-eyebrow">Sama-sama sa panalangin</p>
        <p
          class="prayer-status"
          data-flores-status
          role="status"
          aria-atomic="true"
        >
        </p>
      </header>
      <h2 id="flores-prayer-title" data-flores-title></h2>
      <div class="devotion-beads" data-flores-beads role="img" hidden></div>
      <div class="flores-reading" data-flores-reading></div>
      <p class="up-next" data-flores-up-next></p>
      <div class="prayer-complete" data-flores-complete hidden>
        <p>
          Manatili sandali sa tahimik na panalangin. Nawa’y ang ating pagdarasal
          kasama si Maria ay maglapit sa atin kay Hesus.
        </p>
        <button class="prayer-next" type="button" data-flores-action="restart"
          >Manalangin muli</button
        >
      </div>
    </article>

    <footer class="flores-controls" aria-label="Mga kontrol sa panalangin">
      <div class="prayer-navigation">
        <button class="prayer-back" type="button" data-flores-action="previous"
          >← Bumalik</button
        >
        <div class="prayer-position">
          <span class="bead-count" data-flores-bead-count hidden></span>
          <span class="phase-dots" aria-hidden="true"
            >{phases.map(([id]) => <span data-flores-dot={id} />)}</span
          >
          <span data-flores-position></span>
        </div>
        <button class="prayer-next" type="button" data-flores-action="next"
          >Susunod →</button
        >
      </div>
    </footer>
  </div>

  <details class="flores-reference" data-flores-reference open>
    <summary
      ><span class="page-eyebrow">Mga panalangin sa bawat araw</span><span
        >{
          isNovena
            ? "Buong teksto ng pagsisiyam"
            : "Buong teksto ng Flores de Maria"
        }</span
      ><span aria-hidden="true">＋</span></summary
    >
    <div class="reference-body">
      <div class="content" data-flores-source><slot /></div>
    </div>
  </details>
</devotion-guide>

<script>
  import { prepareFloresGuide } from "@/lib/flores-guide-client";
  import { prepareNovenaWalkthrough } from "@/lib/novena-walkthrough-client";
  class DevotionGuide extends HTMLElement {
    private cleanup?: () => void;
    connectedCallback() {
      this.cleanup =
        this.dataset.devotion === "novena"
          ? prepareNovenaWalkthrough(this)
          : prepareFloresGuide(this);
    }
    disconnectedCallback() {
      this.cleanup?.();
    }
  }
  if (!customElements.get("devotion-guide"))
    customElements.define("devotion-guide", DevotionGuide);
</script>

<style>
  .flores-guide {
    --flores-ink: var(--color-text-dark);
    --flores-muted: var(--color-text);
    --flores-paper: #fffefb;
    --flores-wash: var(--color-light);
    --flores-line: var(--color-border);
    --flores-gold: var(--color-accent);
    --flores-rubric: #a3413b;
    display: block;
    color: var(--flores-ink);
  }
  :global(.dark) .flores-guide {
    --flores-ink: var(--color-darkmode-text-dark);
    --flores-muted: var(--color-darkmode-text);
    --flores-paper: #1c2933;
    --flores-wash: var(--color-darkmode-light);
    --flores-line: var(--color-darkmode-border);
    --flores-gold: var(--color-darkmode-accent);
    --flores-rubric: #eca69e;
  }
  .flores-guide :global([hidden]) {
    display: none !important;
  }
  .flores-guide button:focus-visible,
  .flores-guide select:focus-visible,
  .flores-guide summary:focus-visible {
    outline: 3px solid var(--flores-gold);
    outline-offset: 4px;
  }
  .flores-invitation {
    background: #163d53;
    color: #fff9ed;
    border-radius: 0.75rem;
    border-top: 4px solid #d9bd86;
    padding: clamp(1.25rem, 3vw, 2.5rem);
  }
  .invitation-eyebrow {
    color: #e7cf9b;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }
  .flores-invitation h2 {
    color: inherit;
    font-size: clamp(32px, 3.5vw, 46px);
    line-height: 1.1;
    font-weight: 400;
    margin-bottom: 1rem;
  }
  .flores-invitation > p:not(.invitation-eyebrow) {
    color: #d3e1e7;
    font-size: 18px;
    line-height: 1.5;
    max-width: 65ch;
  }
  .day-choice {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid #668494;
  }
  .tile-choice {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid #668494;
  }
  .tile-choice h3 {
    font-family: var(--font-primary);
    font-size: 16px;
    font-weight: 500;
    color: #fff9ed;
    margin-bottom: 0.85rem;
  }
  .tile-choice > p {
    color: #d3e1e7;
    font-size: 15px;
    line-height: 1.5;
    margin-top: 1rem;
  }
  .novena-date-tiles,
  .novena-mystery-tiles {
    display: grid;
    gap: 0.6rem;
  }
  .novena-date-tiles {
    grid-template-columns: repeat(9, minmax(0, 1fr));
  }
  .novena-mystery-tiles {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .tile-choice button {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    color: #fff9ed;
    border: 1px solid #668494;
    border-radius: 0.4rem;
    padding: 0.85rem 0.35rem;
    cursor: pointer;
    min-width: 0;
    min-height: 44px;
  }
  .novena-date-tiles button {
    align-items: center;
    text-align: center;
  }
  .novena-mystery-tiles button {
    align-items: flex-start;
    text-align: left;
    padding: 1rem 1.25rem;
  }
  .tile-choice button:hover,
  .tile-choice button[aria-pressed="true"] {
    background: #f0ddb4;
    color: #17374a;
    border-color: #f0ddb4;
  }
  .tile-choice button:focus-visible {
    outline-color: #e7cf9b;
  }
  .tile-eyebrow {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .tile-choice strong {
    font-family: var(--font-secondary);
    font-size: 34px;
    font-weight: 400;
    line-height: 1.15;
  }
  .novena-mystery-tiles strong {
    font-size: 30px;
  }
  .tile-date {
    font-size: 13px;
    line-height: 1.5;
  }
  .day-choice label {
    font-size: 16px;
  }
  .day-choice select {
    max-width: 100%;
    background: #fff9ed;
    color: #17374a;
    border: 1px solid #f0ddb4;
    border-radius: 0.35rem;
    min-width: 150px;
    min-height: 48px;
    font-size: 18px;
    padding: 0.5rem 2.5rem 0.5rem 1rem;
    cursor: pointer;
  }
  .day-choice p {
    flex-basis: 100%;
    color: #d3e1e7;
    font-size: 15px;
    line-height: 1.5;
  }
  .flores-workspace {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    align-items: start;
    gap: 2rem;
    margin-top: 2rem;
  }
  .flores-route {
    position: sticky;
    top: 7rem;
    padding-top: 1rem;
  }
  .flores-route nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .flores-route nav button {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    padding: 0.75rem;
    text-align: left;
    font-size: 17px;
    line-height: 1.5;
    border-radius: 0.35rem;
    cursor: pointer;
    color: var(--flores-ink);
  }
  .route-number {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    border: 1px solid var(--flores-line);
    border-radius: 50%;
    font-size: 13px;
    color: var(--flores-gold);
  }
  .flores-route nav button[aria-current],
  .flores-route nav button:hover {
    background: var(--flores-wash);
  }
  .flores-route nav button[aria-current] .route-number {
    background: #163d53;
    color: #fff9ed;
    border-color: #163d53;
  }
  .mystery-shortcuts {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 3px;
    padding: 0.25rem 0.25rem 0.75rem;
  }
  .flores-route nav .mystery-shortcuts button {
    display: grid;
    place-items: center;
    padding: 0.4rem;
    min-width: 0;
    min-height: 44px;
    border: 1px solid var(--flores-line);
    color: var(--flores-muted);
    font-size: 16px;
  }
  .flores-route nav .mystery-shortcuts button[aria-current] {
    background: #f0ddb4;
    color: #17374a;
    border-color: #f0ddb4;
    font-weight: 600;
  }
  @media (min-width: 901px) {
    .flores-route:has(.mystery-shortcuts) {
      max-height: calc(100svh - 13rem);
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: thin;
    }
  }
  .route-note {
    color: var(--flores-rubric);
    font-size: 15px;
    line-height: 1.6;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--flores-line);
  }
  .restart-prayer {
    color: var(--flores-muted);
    font-size: 15px;
    min-height: 44px;
    padding-block: 0.75rem;
    text-decoration: underline;
    text-underline-offset: 4px;
    cursor: pointer;
  }
  .flores-panel {
    min-width: 0;
    min-height: 32rem;
    border: 1px solid var(--flores-line);
    border-radius: 0.75rem;
    background: var(--flores-paper);
    padding: clamp(1.25rem, 3vw, 3rem);
    scroll-margin-top: 7rem;
  }
  .flores-panel:focus {
    outline: none;
  }
  .panel-header {
    border-bottom: 1px solid var(--flores-line);
    padding-bottom: 1.25rem;
    margin-bottom: 1.5rem;
  }
  .prayer-status {
    color: var(--flores-muted);
    font-size: 16px;
    line-height: 1.5;
  }
  .flores-panel h2 {
    font-weight: 400;
    font-size: clamp(32px, 3vw, 42px);
    line-height: 1.15;
    color: var(--flores-ink);
    text-wrap: balance;
  }
  .flores-reading {
    font-family: var(--font-readings);
    font-size: clamp(23px, 2.3vw, 27px);
    line-height: 1.6;
    overflow-wrap: break-word;
  }
  .flores-reading :global(p) {
    margin-top: 1.5rem;
  }
  .flores-reading :global(.prayer-rubric),
  .reference-body :global(.prayer-rubric) {
    color: var(--flores-rubric);
  }
  .flores-reading :global(.prayer-rubric) {
    font-family: var(--font-primary);
    font-size: 17px;
    line-height: 1.6;
  }
  .flores-reading :global(strong) {
    font-weight: 600;
  }
  .booklet-link {
    display: inline-block;
    margin-top: 1.25rem;
    font-size: 16px;
    min-height: 44px;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .bead-count {
    font-size: 18px;
    color: var(--flores-ink);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .devotion-beads {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }
  .devotion-beads :global(span) {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 1px solid var(--flores-line);
    border-radius: 50%;
    font-size: 12px;
    color: var(--flores-muted);
  }
  .devotion-beads :global(.current-bead) {
    background: #163d53;
    color: #fff9ed;
    border-color: #163d53;
  }
  .up-next {
    color: var(--flores-muted);
    font-size: 14px;
    line-height: 1.5;
    text-align: right;
    margin-top: 2rem;
  }
  .prayer-complete {
    font-size: 20px;
    line-height: 1.6;
    margin-top: 1.5rem;
  }
  .prayer-complete button {
    margin-top: 1.5rem;
    min-height: 44px;
    padding: 0.75rem 1rem;
    cursor: pointer;
  }
  .flores-controls {
    position: fixed;
    inset: auto 0 0;
    z-index: 20;
    border-top: 1px solid var(--flores-line);
    background: var(--flores-paper);
    box-shadow: 0 -8px 28px rgb(15 35 45 / 8%);
    padding: 0.75rem max(1rem, env(safe-area-inset-right, 0px))
      calc(0.75rem + env(safe-area-inset-bottom, 0px))
      max(1rem, env(safe-area-inset-left, 0px));
  }
  .prayer-navigation {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 150px minmax(0, 1fr);
    gap: 1rem;
    align-items: center;
    max-width: 1224px;
    margin-inline: auto;
  }
  .prayer-navigation button {
    height: 52px;
    padding: 0.65rem 1rem;
    font-size: 17px;
    line-height: 1.15;
    cursor: pointer;
  }
  .prayer-back {
    color: var(--flores-muted);
    width: 140px;
    justify-self: start;
  }
  .prayer-navigation .prayer-next {
    width: 200px;
    justify-self: end;
  }
  .prayer-navigation button:disabled {
    opacity: 0.4;
    cursor: default;
  }
  .prayer-next {
    background: #163d53;
    color: #fff9ed;
    border-radius: 0.3rem;
  }
  .prayer-next:hover {
    background: #214f68;
  }
  .prayer-position {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    text-align: center;
  }
  .prayer-position > span:last-child {
    color: var(--flores-muted);
    font-size: 12px;
    line-height: 1.2;
  }
  .phase-dots {
    display: flex;
    gap: 6px;
    padding-block: 4px;
  }
  .phase-dots span {
    width: 10px;
    height: 10px;
    border: 1px solid var(--flores-gold);
    border-radius: 50%;
  }
  .phase-dots .current-phase {
    background: var(--flores-gold);
  }
  .flores-reference {
    border: 1px solid var(--flores-line);
    border-radius: 0.75rem;
    margin-top: 2rem;
    background: var(--flores-paper);
  }
  .flores-reference > summary {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.4rem 1rem;
    padding: 1.5rem;
    cursor: pointer;
    font-family: var(--font-secondary);
    font-size: 27px;
    line-height: 1.3;
  }
  .flores-reference > summary .page-eyebrow {
    grid-column: 1;
  }
  .flores-reference > summary > span:last-child {
    grid-column: 2;
    grid-row: 1 / 3;
    align-self: center;
    color: var(--flores-gold);
  }
  .reference-body {
    padding: 0 clamp(1.25rem, 3vw, 3rem) 2rem;
  }
  :global(body:has(devotion-guide[data-enhanced])) {
    padding-bottom: calc(6rem + env(safe-area-inset-bottom, 0px));
  }
  :global(html:has(devotion-guide[data-enhanced])) {
    scroll-padding-bottom: calc(6rem + env(safe-area-inset-bottom, 0px));
  }
  @media (max-width: 900px) {
    .novena-date-tiles {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .novena-mystery-tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .mystery-shortcuts {
      flex: 0 0 236px;
      padding-bottom: 0;
    }
    .flores-workspace {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }
    .flores-route {
      position: static;
      padding-top: 0;
      min-width: 0;
    }
    .flores-route nav {
      flex-direction: row;
      overflow-x: auto;
      padding: 0.25rem 0.25rem 0.75rem;
    }
    .flores-route nav button {
      flex: 0 0 auto;
      border: 1px solid var(--flores-line);
    }
    .route-note,
    .restart-prayer {
      display: none;
    }
  }
  @media (max-width: 600px) {
