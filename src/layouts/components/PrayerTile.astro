---
import { LuBookOpen, LuCalendar, LuArrowRight } from "react-icons/lu";

interface Props {
  title: string;
  href: string;
  description: string;
  note: string;
  label: string;
  kind: "novena" | "guide";
}
const { title, href, description, note, label, kind } = Astro.props;
const Icon = kind === "novena" ? LuCalendar : LuBookOpen;
---

<a href={href} class="prayer-tile">
  <span class="tile-icon"><Icon size={28} aria-hidden="true" /></span>
  <h2>{title}</h2>
  <p class="tile-note">{note}</p>
  <p class="tile-description">{description}</p>
  <span class="tile-link"
    >{label}<LuArrowRight size={18} aria-hidden="true" /></span
  >
</a>

<style>
  .prayer-tile {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 2rem;
    border: 1px solid var(--color-border);
    border-radius: 0.7rem;
    color: var(--color-text);
    transition: border-color 0.2s;
  }
  .prayer-tile:hover {
    border-color: var(--color-accent);
  }
  .prayer-tile:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }
  .tile-icon {
    color: var(--color-accent);
    margin-bottom: 1.5rem;
  }
  h2 {
    font-size: 30px;
    line-height: 1.25;
    margin-bottom: 1rem;
  }
  .tile-note {
    font-size: 18px;
    line-height: 28px;
    font-weight: 500;
    color: var(--color-primary);
    margin-bottom: 1rem;
  }
  .tile-description {
    flex-grow: 1;
    font-size: var(--reading-size);
    line-height: 28px;
  }
  .tile-link {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-top: 1.5rem;
  }
  :global(.dark) .prayer-tile {
    border-color: var(--color-darkmode-border);
    color: var(--color-darkmode-text);
  }
  :global(.dark) .prayer-tile:hover {
    border-color: var(--color-darkmode-accent);
  }
  :global(.dark) .tile-icon {
    color: var(--color-darkmode-accent);
  }
  :global(.dark) .tile-note,
  :global(.dark) .tile-link {
    color: var(--color-darkmode-primary);
  }
  @media (max-width: 640px) {
    .prayer-tile {
      padding: 1.5rem;
    }
  }
</style>
