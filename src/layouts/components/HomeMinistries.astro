---
import {
  FaArrowRight,
  FaBookOpen,
  FaHandsHelping,
  FaMusic,
  FaCross,
  FaPlus,
} from "react-icons/fa";

const ministries = [
  {
    name: "Music Ministry",
    invitation: "Lift our prayer in song",
    description:
      "Lend your voice or musical gifts to help our community sing and pray together.",
    detail:
      "Interested in singing or playing an instrument? Ask the chapel team how to meet the choir and learn about rehearsals.",
    icon: FaMusic,
    link: { label: "Explore our songs", href: "/songs" },
  },
  {
    name: "Lectors and Commentators",
    invitation: "Give the Word a voice",
    description:
      "Help proclaim Scripture and guide the assembly through our celebrations.",
    detail:
      "If you feel drawn to reading and speaking in service of the liturgy, ask about preparation and training with the ministry.",
    icon: FaBookOpen,
    link: { label: "Prepare with the readings", href: "/readings" },
  },
  {
    name: "Extraordinary Ministers of Holy Communion",
    invitation: "Serve with reverence",
    description:
      "Assist in distributing Holy Communion, following the parish’s guidance.",
    detail:
      "Speak with the chapel team about discernment, formation, and the parish requirements for serving in this ministry.",
    icon: FaCross,
  },
  {
    name: "Mother Butler Guild",
    invitation: "Care for what is sacred",
    description:
      "Offer a helping hand in caring for the altar, sacred linens, and our chapel’s worship space.",
    detail:
      "Small acts of care help prepare a welcoming place for worship. Ask the chapel team how you can help with the guild’s work.",
    icon: FaHandsHelping,
  },
];
---

<section class="ministry-section" aria-labelledby="ministry-title">
  <div class="container ministry-layout">
    <div class="ministry-intro">
      <p class="ministry-kicker">Faith in action · Volunteer with us</p>
      <h2 id="ministry-title">Your gifts<br />belong here.</h2>
      <p class="ministry-lead">
        A voice. A helping hand. A little of your time. There are many ways to
        serve Our Lady of the Most Holy Rosary Chapel.
      </p>
      <p class="ministry-welcome">
        Whether you’ve served before or are simply curious, let’s find a place
        for you to begin.
      </p>
      <a class="ministry-start" href="#volunteer-first-step">
        How to get involved <FaArrowRight aria-hidden="true" />
      </a>
      <span class="ministry-flourish" aria-hidden="true">✦</span>
    </div>

    <div class="ministry-grid">
      {
        ministries.map(
          ({ name, invitation, description, detail, icon: Icon, link }) => (
            <article class="ministry-card">
              <span class="ministry-card-top">
                <span class="ministry-icon">
                  <Icon aria-hidden="true" />
                </span>
                <span class="ministry-invitation">{invitation}</span>
              </span>
              <h3>{name}</h3>
              <p class="ministry-description">{description}</p>
              <details>
                <summary aria-label={`${name}: ways to take part`}>
                  <span class="ministry-disclosure">
                    <span class="ministry-closed-label">Ways to take part</span>
                    <span class="ministry-open-label">Close details</span>
                    <FaPlus aria-hidden="true" />
                  </span>
                </summary>
                <div class="ministry-detail">
                  <p>{detail}</p>
                  {link && (
                    <a href={link.href}>
                      {link.label}
                      <FaArrowRight aria-hidden="true" />
                    </a>
                  )}
                </div>
              </details>
            </article>
          ),
        )
      }
    </div>

    <div class="ministry-next" id="volunteer-first-step" tabindex="-1">
      <div>
        <p class="ministry-kicker">Your first step</p>
        <h3>Let’s begin with a conversation.</h3>
        <p>
          Speak with the chapel team after Mass and tell us which ministry
          interests you. Ask about the next steps, preparation, and how you can
          help.
        </p>
      </div>
      <a class="ministry-mass" href="/mass"
        >Find our Mass schedule <FaArrowRight aria-hidden="true" /></a
      >
    </div>
  </div>
</section>

<style>
  .ministry-section {
    --ministry-paper: #fff7e8;
    --ministry-muted: #d0d9de;
    --ministry-gold: #e8d4ae;
    --ministry-line: #66757e;
    background: #263c50;
    color: var(--ministry-paper);
    border-block: 1px solid var(--ministry-line);
    padding-block: clamp(3rem, 6vw, 6rem);
  }
  .ministry-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
    gap: 3rem 4rem;
  }
  .ministry-intro {
    min-width: 0;
  }
  .ministry-kicker {
    color: var(--ministry-gold);
    font-size: 13px;
    line-height: 1.6;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    margin: 0 0 1.5rem;
  }
  h2 {
    color: var(--ministry-paper);
    font-family: var(--font-secondary);
    font-weight: 400;
    font-size: clamp(3.5rem, 5.3vw, 5.2rem);
    line-height: 1.03;
    letter-spacing: -0.035em;
    margin: 0 0 1.75rem;
  }
  .ministry-lead,
  .ministry-welcome {
    font-size: 20px;
    line-height: 1.6;
    margin: 0 0 1rem;
    max-width: 34ch;
  }
  .ministry-welcome {
    color: var(--ministry-muted);
  }
  a {
    color: var(--ministry-gold);
  }
  a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .ministry-start,
  .ministry-mass,
  .ministry-detail a {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    min-height: 48px;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.5;
    padding-block: 0.75rem;
  }
  a :global(svg) {
    width: 13px;
    flex-shrink: 0;
  }
  .ministry-flourish {
    display: block;
    margin-top: 2.5rem;
    color: var(--ministry-gold);
    font-size: 32px;
  }
  .ministry-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: 1.25rem;
  }
  .ministry-card {
    min-width: 0;
    padding: 1.5rem;
    background: #30495d;
    border: 1px solid var(--ministry-line);
    border-radius: 0.5rem;
    overflow: visible;
  }
  details {
    margin: 0;
  }
  summary {
    display: block;
    list-style: none;
    cursor: pointer;
    padding-block: 0.5rem;
    margin-top: 1rem;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    background: rgb(255 247 232 / 4%);
  }
  .ministry-card-top {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: 1.5rem;
  }
  .ministry-icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border: 1px solid var(--ministry-line);
    border-radius: 50%;
    color: var(--ministry-gold);
  }
  .ministry-icon :global(svg) {
    width: 18px;
    height: 18px;
  }
  .ministry-invitation {
    color: var(--ministry-gold);
    font-size: 15px;
    line-height: 1.4;
  }
  h3 {
    color: var(--ministry-paper);
    font-family: var(--font-secondary);
    font-weight: 400;
    font-size: 28px;
    line-height: 1.17;
    margin: 0 0 1rem;
    text-wrap: balance;
  }
  .ministry-description,
  .ministry-detail p {
    font-size: 19px;
    line-height: 1.55;
    color: var(--ministry-muted);
    margin: 0;
  }
  .ministry-disclosure {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--ministry-gold);
    border-top: 1px solid var(--ministry-line);
    padding-top: 1rem;
    font-size: 16px;
    line-height: 1.5;
  }
  .ministry-disclosure :global(svg) {
    width: 12px;
    flex-shrink: 0;
  }
  .ministry-open-label {
    display: none;
  }
  details[open] .ministry-open-label {
    display: inline;
  }
  details[open] .ministry-closed-label {
    display: none;
  }
  details[open] .ministry-disclosure :global(svg) {
    transform: rotate(45deg);
  }
  .ministry-detail {
    padding-top: 0.75rem;
  }
  .ministry-detail a {
    margin-top: 0.5rem;
    font-size: 17px;
  }
  .ministry-next {
    grid-column: 1/-1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    border-top: 1px solid var(--ministry-line);
    padding-top: 2rem;
    scroll-margin-top: 7rem;
  }
  .ministry-next > div {
    max-width: 43rem;
  }
  .ministry-next .ministry-kicker {
    margin-bottom: 0.6rem;
  }
  .ministry-next h3 {
    font-size: 32px;
    margin-bottom: 0.6rem;
  }
  .ministry-next p:not(.ministry-kicker) {
    color: var(--ministry-muted);
    font-size: 19px;
    line-height: 1.6;
    margin: 0;
  }
  .ministry-mass {
    flex-shrink: 0;
  }
  a:focus-visible,
  summary:focus-visible,
  .ministry-next:focus {
    outline: 3px solid var(--ministry-gold);
    outline-offset: 5px;
  }
  :global(.dark) .ministry-section {
    background: #202d39;
  }
  :global(.dark) .ministry-card {
    background: #293d4e;
  }
  @media (max-width: 1050px) {
    .ministry-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }
    .ministry-intro {
      max-width: 43rem;
    }
    .ministry-lead,
    .ministry-welcome {
      max-width: none;
    }
    .ministry-flourish {
      display: none;
    }
    .ministry-next {
      align-items: flex-start;
      flex-direction: column;
      gap: 1rem;
    }
  }
  @media (max-width: 600px) {
    .ministry-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    h2 {
      font-size: clamp(3rem, 12vw, 4rem);
    }
    .ministry-lead,
    .ministry-welcome {
      font-size: 19px;
    }
    .ministry-kicker {
      letter-spacing: 0.08em;
    }
  }
</style>
