---
import englishCatalog from "@/data/rosary.json";
import tagalogCatalog from "@/data/rosary-tl.json";
import type { RosaryCatalog } from "@/types/rosary";
import RosaryMysteryContent from "@/components/RosaryMysteryContent.astro";
import { validateRosaryMysteries } from "@/lib/rosary-mysteries.mjs";
import { blockRosaryCatalog, blockRosaryPhases } from "@/lib/block-rosary.mjs";
interface Props {
  language?: "en" | "tl";
  variant?: "rosary" | "block";
}
const { language = "en", variant = "rosary" } = Astro.props;
const block = variant === "block";
const tl = language === "tl";
const t = (en: string, tagalog: string) => (tl ? tagalog : en);
const catalog: RosaryCatalog = block
  ? blockRosaryCatalog(englishCatalog)
  : tl
    ? tagalogCatalog
    : englishCatalog;
validateRosaryMysteries(catalog.mysteries);
---

<rosary-guide
  class="rosary-guide"
  lang={language}
  data-rosary-language={language}
  data-rosary-variant={variant}
  data-rosary-catalog={JSON.stringify(catalog)}
>
  <section class="rosary-invitation" aria-labelledby="rosary-invitation-title">
    <p class="invitation-eyebrow">
      {
        block
          ? "A home at a time · A community in prayer"
          : t(
              "Pray with Mary · Contemplate the life of Jesus",
              "Manalangin kasama si Maria · Pagnilayan ang buhay ni Hesus",
            )
      }
    </p>
    <h2 id="rosary-invitation-title">
      {
        block
          ? "Welcome Mary."
          : t("A little stillness.", "Sandali ng katahimikan.")
      }<br />{
        block
          ? "Pray as one family."
          : t("A prayer at a time.", "Isang panalangin sa bawat hakbang.")
      }
    </h2>
    <p>
      {
        block
          ? "Gather your household and neighbors. From the welcoming prayers to the Rosary and prayers for the family, follow together at your own pace."
          : t(
              "From the first Sign of the Cross to the closing prayer, the words are here. Move at your own pace.",
              "Mula sa pag-aantanda ng krus hanggang sa pangwakas na panalangin, narito ang mga salitang darasalin. Manalangin sa sarili mong bilis.",
            )
      }
    </p>
    {
      block ? (
        <p class="block-rosary-note">
          The leader reads <strong>℣.</strong> and everyone responds{" "}
          <strong>℟.</strong> Acceptance and farewell are for the arrival and
          departure of the image; skip them on other evenings.
        </p>
      ) : (
        <nav
          class="rosary-languages"
          aria-label={t("Prayer language", "Wika ng panalangin")}
        >
          <a
            href="/prayers/how-to-pray-the-holy-rosary"
            lang="en"
            hreflang="en"
            aria-current={!tl ? "page" : undefined}
          >
            English
          </a>
          <a
            href="/prayers/ang-banal-na-rosaryo"
            lang="tl"
            hreflang="tl"
            aria-current={tl ? "page" : undefined}
          >
            Tagalog
          </a>
        </nav>
      )
    }
    <nav
      class="mystery-choices"
      aria-label={t("Choose the mysteries", "Piliin ang mga misteryo")}
    >
      {
        catalog.mysteries.map(({ id, title, days }, index) => (
          <a href={`#${id}-mysteries`} data-mystery-set={id}>
            <span class="mystery-choice-number" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            <>
              <strong>
                {title
                  .replace(" Mysteries", "")
                  .replace("Mga Misteryo ng ", "")}
              </strong>
              <span>{days}</span>
            </>
          </a>
        ))
      }
    </nav>
    <p class="rosary-suggestion" data-rosary-suggestion></p>
  </section>

  <div class="rosary-workspace" data-rosary-walkthrough hidden>
    <aside
      class="rosary-route"
      aria-label={t(
        "Your place in the Rosary",
        "Ang iyong kinaroroonan sa Rosaryo",
      )}
    >
      <p class="page-eyebrow">
        {t("Your prayer journey", "Gabay sa panalangin")}
      </p>
      <nav
        aria-label={t(
          "Jump to a part of the Rosary",
          "Pumili ng bahagi ng Rosaryo",
        )}
      >
        {
          block && (
            <button type="button" data-rosary-phase="welcome">
              <>
                <span aria-hidden="true">⌂</span>
                <span>Welcome to Mary</span>
              </>
            </button>
          )
        }
        <button type="button" data-rosary-phase="opening"
          ><span aria-hidden="true">✝</span><span
            >{
              block
                ? "The Holy Rosary"
                : t("Opening prayers", "Mga pambungad na panalangin")
            }</span
          ></button
        >
        {
          Array.from({ length: 5 }, (_, index) => (
            <button type="button" data-rosary-phase={index}>
              <>
                <span class="route-number" aria-hidden="true">
                  {index + 1}
                </span>
                <span>
                  {t("Decade", "Misteryo")} {index + 1}
                </span>
              </>
            </button>
          ))
        }
        <button type="button" data-rosary-phase="closing"
          ><span aria-hidden="true">✝</span><span
            >{
              block
                ? "Rosary collect"
                : t("Closing prayers", "Mga pangwakas na panalangin")
            }</span
          ></button
        >
        {
          block &&
            Object.entries(blockRosaryPhases)
              .filter(([id]) => ["litany", "family", "farewell"].includes(id))
              .map(([id, title]) => (
                <button type="button" data-rosary-phase={id}>
                  <>
                    <span aria-hidden="true">✝</span>
                    <span>{title}</span>
                  </>
                </button>
              ))
        }
      </nav>
      <p class="route-note">
        {t("Instructions appear in red.", "Ang mga tagubilin ay nasa pula.")}<br
        />{t("Pray the larger text.", "Dasalin ang malaking teksto.")}
      </p>
      <button class="restart-prayer" type="button" data-rosary-action="restart"
        >{t("Start again", "Magsimula muli")}</button
      >
    </aside>

    <article
      id="prayer-guide"
      class="walkthrough-panel"
      data-rosary-panel
      tabindex="-1"
      aria-labelledby="rosary-prayer-title"
    >
      <header class="walkthrough-header">
        <p class="page-eyebrow">
          {t("In prayer together", "Sama-sama sa panalangin")}
        </p>
        <p
          class="walkthrough-status"
          data-rosary-status
          role="status"
          aria-atomic="true"
        >
        </p>
        <p class="walkthrough-position" data-rosary-position></p>
      </header>
      <h2 id="rosary-prayer-title" data-rosary-title></h2>
      <div data-rosary-reading>
        <div class="prayer-context">
          <p data-rosary-context></p><span
            class="prayer-count"
            data-rosary-count
            hidden></span>
        </div>
        <div class="prayer-beads" data-rosary-beads role="img" hidden></div>
        <p class="walkthrough-rubric"><em data-rosary-rubric></em></p>
        <p class="prayer-words" data-rosary-text></p>
        <p
          class="walkthrough-rubric prayer-note"
          data-rosary-prayer-note
          hidden
        >
        </p>
        <div class="mystery-introduction" data-rosary-introduction hidden></div>
        <details class="mystery-reflection" data-rosary-reflection hidden>
          <summary
            >{
              t(
                "View artwork & meditation",
                "Tingnan ang larawan at pagninilay",
              )
            }</summary
          >
          <div
            class="mystery-reflection-content"
            data-rosary-reflection-content
          >
          </div>
        </details>
        <button
          class="skip-prayer"
          type="button"
          data-rosary-action="skip"
          data-rosary-skip
          hidden
          >{
            t("Skip this optional prayer →", "Laktawan ang panalanging ito →")
          }</button
        >
        <p class="prayer-up-next" data-rosary-up-next></p>
        <footer
          class="walkthrough-controls"
          data-rosary-controls
          aria-label={t("Prayer controls", "Mga kontrol sa panalangin")}
        >
          <div class="prayer-navigation">
            <button
              class="prayer-back"
              type="button"
              data-rosary-action="previous"
              >{t("← Previous", "← Bumalik")}</button
            >
            <div class="prayer-control-position">
              <span data-rosary-control-count></span>
              <span
                class="prayer-control-beads"
                data-rosary-control-beads
                role="img"
              >
                {Array.from({ length: 5 }, () => <span aria-hidden="true" />)}
              </span>
              <span data-rosary-control-label></span>
            </div>
            <button
              class="prayer-next"
              type="button"
              data-rosary-action="next"
              data-rosary-next>{t("Next prayer →", "Susunod →")}</button
            >
          </div>
        </footer>
      </div>
      <div class="rosary-complete" data-rosary-complete hidden>
        <p>
          {
            t(
              "Remain for a moment in quiet prayer.",
              "Manatili sandali sa tahimik na panalangin.",
            )
          }
        </p>
        <div class="completion-actions">
          <button type="button" class="prayer-next" data-rosary-action="restart"
            >{t("Pray again", "Manalangin muli")}</button
          ><button type="button" data-rosary-action="previous"
            >{
              t("Return to the final prayer", "Balikan ang huling panalangin")
            }</button
          >
        </div>
      </div>
    </article>
  </div>

  <details class="rosary-reference" data-rosary-reference open>
    <summary
      ><span class="page-eyebrow"
        >{t("Keep close at hand", "Mga panalangin at gabay")}</span
      ><span
        >{
          t("Full prayer booklet & guide", "Buong teksto at gabay sa Rosaryo")
        }</span
      ><span aria-hidden="true">＋</span></summary
    >
    <div class="reference-body">
      <div class="content"><slot /></div>
      <section id="rosary-prayer-texts" aria-labelledby="prayer-texts-title">
        <p class="page-eyebrow">
          {t("The words we pray", "Ang mga salitang darasalin")}
        </p><h2 id="prayer-texts-title">
          {t("Prayers of the Rosary", "Mga Panalangin ng Rosaryo")}
        </h2>
        {
          catalog.prayers.map((prayer) => (
            <section
              class="reference-prayer"
              aria-labelledby={`rosary-${prayer.id}`}
            >
              <h3 id={`rosary-${prayer.id}`}>{prayer.title}</h3>
              {prayer.instruction && (
                <p class="reference-rubric">
                  <em>{prayer.instruction}</em>
                </p>
              )}
              {!block && prayer.id === "fatima" && (
                <p class="reference-rubric">
                  {t(
                    "Optional, after each decade.",
                    "Maaaring dasalin pagkatapos ng bawat misteryo.",
                  )}
                </p>
              )}
              <p class="prayer-words">
                {block
                  ? prayer.text
                      .split(/([℣℟]\.)/g)
                      .map((part) =>
                        /^[℣℟]\.$/.test(part) ? <strong>{part}</strong> : part,
                      )
                  : prayer.text}
              </p>
              {prayer.rubric && (
                <p class="reference-rubric">
                  <em>{prayer.rubric}</em>
                </p>
              )}
            </section>
          ))
        }
      </section>
      <section
        class="reference-mysteries"
        aria-labelledby="rosary-mysteries-title"
      >
        <p class="page-eyebrow">
          {
            t(
              "Contemplate the life of Jesus with Mary",
              "Pagnilayan ang buhay ni Hesus kasama si Maria",
            )
          }
        </p><h2 id="rosary-mysteries-title">
          {
            t(
              "The four sets of mysteries",
              "Ang Apat na Pangkat ng mga Misteryo",
            )
          }
        </h2>
        {
          catalog.mysteries.map((set) => (
            <section aria-labelledby={`${set.id}-mysteries`}>
              <>
                <h3 id={`${set.id}-mysteries`}>{set.title}</h3>
                <p>{set.days}</p>
              </>
              <ol>
                {set.items.map((item) => (
                  <li>
                    <span data-rosary-mystery-title>{item.title}</span>
                    <div data-rosary-mystery-content={item.id}>
                      <RosaryMysteryContent item={item} />
                    </div>
                  </li>
                ))}
              </ol>
            </section>
          ))
        }
      </section>
      {
        block ? (
          <p class="rosary-sources">
            The suggested mysteries follow the customary weekly pattern. You may
            choose another set for the season or your community’s prayer. The
            standard prayers and mystery meditations are shared with our{" "}
            <a href="/prayers/how-to-pray-the-holy-rosary#prayer-guide">
              English Rosary Guide
            </a>
            .
          </p>
        ) : tl ? (
          <p class="rosary-sources">
            Mga panalangin at misteryo mula sa aklat na ginagamit ng ating
            pamayanan. Ang mungkahing misteryo ay ayon sa karaniwang araw ng
            pagdarasal; maaaring pumili ng ibang pangkat ayon sa panahon o
            pagdarasal ng pamayanan.
          </p>
        ) : (
          <p class="rosary-sources">
            Traditional English prayer texts. Sequence and prayer references:{" "}
            <a href="https://www.usccb.org/how-to-pray-the-rosary">
              USCCB Rosary guide
            </a>
            ,{" "}
            <a href="https://www.usccb.org/prayers/prayers-rosary">
              Prayers of the Rosary
            </a>
            , and{" "}
            <a href="https://www.vatican.va/special/rosary/documents/misteri_en.html">
              the Holy See’s mystery guide
            </a>
            . The day-based suggestion follows the customary weekly pattern;
            another set may be chosen for the season or community’s prayer.
          </p>
        )
      }
    </div>
  </details>
</rosary-guide>

<script>
  import { prepareRosaryGuide } from "@/lib/rosary-guide-client";
  class RosaryGuide extends HTMLElement {
    private cleanup?: () => void;
    connectedCallback() {
      this.cleanup = prepareRosaryGuide(this);
    }
    disconnectedCallback() {
      this.cleanup?.();
    }
  }
  if (!customElements.get("rosary-guide"))
    customElements.define("rosary-guide", RosaryGuide);
</script>

<style>
  .rosary-guide {
    --rosary-ink: var(--color-text-dark);
    --rosary-muted: var(--color-text);
    --rosary-paper: #fffefb;
    --rosary-wash: var(--color-light);
    --rosary-line: var(--color-border);
    --rosary-gold: var(--color-accent);
    --rosary-rubric: #a3413b;
    display: block;
    color: var(--rosary-ink);
  }
  :global(.dark) .rosary-guide {
    --rosary-ink: var(--color-darkmode-text-dark);
    --rosary-muted: var(--color-darkmode-text);
    --rosary-paper: #1c2933;
    --rosary-wash: var(--color-darkmode-light);
    --rosary-line: var(--color-darkmode-border);
    --rosary-gold: var(--color-darkmode-accent);
    --rosary-rubric: #eca69e;
  }
  .rosary-guide :global([hidden]) {
    display: none !important;
  }
  .rosary-guide a:focus-visible,
  .rosary-guide button:focus-visible,
  .rosary-guide summary:focus-visible {
    outline: 3px solid var(--rosary-gold);
    outline-offset: 4px;
  }
  .rosary-invitation {
    border-radius: 0.75rem;
    background: #163d53;
    color: #fff9ed;
    border-top: 4px solid #d9bd86;
    padding: clamp(1.25rem, 3vw, 2.5rem);
  }
  .block-rosary-note {
    max-width: 65ch;
    color: #f0ddb4;
    margin-top: 1.5rem;
  }
  .invitation-eyebrow {
    color: #e7cf9b;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }
  .rosary-invitation h2 {
    color: inherit;
    font-size: clamp(32px, 3.5vw, 46px);
    line-height: 1.1;
    font-weight: 400;
    margin-bottom: 1rem;
  }
  .rosary-invitation > p:not(.invitation-eyebrow) {
    color: #d3e1e7;
    font-size: 18px;
    line-height: 1.5;
    max-width: 65ch;
  }
  .mystery-choices {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .rosary-languages {
    display: inline-flex;
    gap: 0.4rem;
    margin-top: 1.5rem;
    padding: 0.25rem;
    border: 1px solid #668494;
    border-radius: 0.4rem;
    font-size: 16px;
  }
  .rosary-languages a {
    padding: 0.5rem 1rem;
    border-radius: 0.2rem;
    min-height: 44px;
  }
  .rosary-languages a[aria-current],
  .rosary-languages a:hover {
    background: #f0ddb4;
    color: #17374a;
  }
  .mystery-choices a {
    display: flex;
    flex-direction: column;
    padding: 1rem 1.25rem;
    border: 1px solid #668494;
    border-radius: 0.4rem;
  }
  .mystery-choices a:hover,
  .mystery-choices a[aria-current] {
    background: #f0ddb4;
    color: #17374a;
    border-color: #f0ddb4;
  }
  .mystery-choices a:focus-visible {
    outline-color: #e7cf9b;
  }
  .mystery-choice-number {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    margin-bottom: 0.5rem;
  }
  .mystery-choices strong {
    font-family: var(--font-secondary);
    font-size: 30px;
    font-weight: 400;
    line-height: 1.2;
  }
  .mystery-choices a > span:last-child {
    font-size: 14px;
    line-height: 1.5;
    margin-top: 0.4rem;
  }
  .rosary-invitation .rosary-suggestion {
    font-size: 15px;
    margin-top: 1rem;
    max-width: none;
  }
  .rosary-workspace {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    align-items: start;
    gap: 2rem;
    margin-top: 2rem;
  }
  .rosary-route {
    position: sticky;
    top: 7rem;
    padding-top: 1rem;
  }
  .rosary-route nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .rosary-route nav button {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    padding: 0.75rem;
    text-align: left;
    font-size: 17px;
    line-height: 1.5;
    border-radius: 0.35rem;
    cursor: pointer;
    color: var(--rosary-ink);
  }
  .rosary-route nav button > span:first-child {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    color: var(--rosary-gold);
  }
  .route-number {
    border: 1px solid var(--rosary-line);
    border-radius: 50%;
    font-size: 13px;
  }
  .rosary-route nav button[aria-current],
  .rosary-route nav button:hover {
    background: var(--rosary-wash);
  }
  .rosary-route nav button[aria-current] .route-number {
    background: #163d53;
    color: #fff9ed;
    border-color: #163d53;
  }
  .route-note {
    color: var(--rosary-rubric);
    font-size: 15px;
    line-height: 1.6;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rosary-line);
  }
  .restart-prayer {
    font-size: 15px;
    text-decoration: underline;
    text-underline-offset: 4px;
    padding-block: 0.75rem;
    min-height: 44px;
    cursor: pointer;
    color: var(--rosary-muted);
  }
  .walkthrough-panel {
    min-width: 0;
    border: 1px solid var(--rosary-line);
    border-radius: 0.75rem;
    background: var(--rosary-paper);
    padding: clamp(1.25rem, 3vw, 3rem);
    scroll-margin-top: 7rem;
  }
  .walkthrough-panel:focus {
    outline: none;
  }
  .walkthrough-header {
    border-bottom: 1px solid var(--rosary-line);
    padding-bottom: 1.25rem;
    margin-bottom: 1.5rem;
  }
  .walkthrough-status {
    color: var(--rosary-muted);
    font-size: 16px;
    line-height: 1.5;
  }
  .walkthrough-position {
    color: var(--rosary-muted);
    font-size: 13px;
    line-height: 1.5;
    margin-top: 0.25rem;
  }
  .walkthrough-panel h2 {
    font-weight: 400;
    font-size: clamp(32px, 3vw, 42px);
    line-height: 1.15;
    color: var(--rosary-ink);
    text-wrap: balance;
  }
  .prayer-context {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.75rem;
    color: var(--rosary-muted);
    font-size: 16px;
    line-height: 1.5;
  }
  .prayer-count {
    color: var(--rosary-gold);
    font-weight: 600;
    white-space: nowrap;
  }
  .prayer-beads {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .prayer-beads :global(span) {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 1px solid var(--rosary-line);
    border-radius: 50%;
    font-size: 12px;
    color: var(--rosary-muted);
  }
  .prayer-beads :global(.current-bead) {
    color: #fff9ed;
    background: #163d53;
    border-color: #163d53;
  }
  .walkthrough-rubric {
    color: var(--rosary-rubric);
    font-size: 17px;
    line-height: 1.6;
    margin-top: 1.5rem;
  }
  .prayer-words {
    font-family: var(--font-readings);
    font-size: clamp(23px, 2.3vw, 27px);
    line-height: 1.6;
    white-space: pre-line;
    overflow-wrap: break-word;
    margin-top: 1.5rem;
  }
  .prayer-note {
    font-style: italic;
  }
  .mystery-introduction {
    margin-top: 2rem;
  }
  .mystery-reflection {
    margin-top: 1.5rem;
    border: 1px solid var(--rosary-line);
    border-radius: 0.4rem;
  }
  .mystery-reflection > summary {
    cursor: pointer;
    color: var(--rosary-gold);
    font-size: 17px;
    line-height: 1.5;
    padding: 0.85rem 1rem;
  }
  .mystery-reflection-content {
    padding: 0 1rem 1.25rem;
  }
  .reference-mysteries li {
    margin-block: 1rem;
  }
  .reference-mysteries [data-rosary-mystery-content]:not(:empty) {
    margin-block: 1rem 2rem;
  }
  .skip-prayer {
    color: var(--rosary-gold);
    font-size: 16px;
