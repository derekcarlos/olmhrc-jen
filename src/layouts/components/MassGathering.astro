---
import { getCollection } from "astro:content";
import { nextHomeMass } from "@/lib/home-bulletin.mjs";
import { massInvitation } from "@/lib/mass-invitation.mjs";
import { formatEventTime } from "@/lib/calendar.mjs";
import {
  FaArrowRight,
  FaBookOpen,
  FaMusic,
  FaRegCalendarPlus,
} from "react-icons/fa";

const schedules = (
  await getCollection("events", ({ data }) => !data.draft)
).map(({ id, data }) => ({ id, ...data }));
const mass = nextHomeMass(schedules);
const invitation = massInvitation(mass);
---

<div class="mass-experience not-prose">
  <div class="mass-introduction">
    <p class="eyebrow">Our Lady of the Most Holy Rosary Chapel</p>
    <h2>A community gathered<br />around one table.</h2>
    <p>
      Join your neighbors in prayer at Jubilation Enclave North, Biñan, Laguna.
    </p>
  </div>

  <div class="gathering-spread">
    <section
      class="next-celebration"
      data-home-mass
      data-schedules={JSON.stringify(schedules)}
      aria-labelledby="next-celebration-title"
    >
      <div class="panel-top">
        <p class="eyebrow">Your next invitation</p><span aria-hidden="true"
          >✝</span>
      </div>
      <h3 id="next-celebration-title" data-home-mass-title>
        {mass?.title || "Gather for Mass"}
      </h3>
      <time
        class="celebration-date"
        data-home-mass-date
        datetime={mass?.day}
        aria-label={invitation.dateLabel}
      >
        <span data-home-mass-day>{invitation.weekday}</span><span
          aria-hidden="true">·</span
        >
        <span
          ><span data-home-mass-month>{invitation.month}</span>
          <span data-home-mass-number>{invitation.number}</span>, <span
            data-home-mass-year>{invitation.year}</span
          ></span
        >
      </time>
      <time
        class="celebration-time"
        data-home-mass-time
        datetime={invitation.dateTime || undefined}
        >{mass ? formatEventTime(mass.time) : "See schedule"}</time
      >
      <span class="time-zone" data-home-mass-zone hidden={!mass?.time}
        >Philippine Time</span
      >
      <p
        class="celebration-location"
        data-home-mass-location
        hidden={!mass?.location}
      >
        {mass?.location}
      </p>
      <div class="celebration-actions">
        <a class="save-mass" data-home-mass-save hidden
          ><FaRegCalendarPlus aria-hidden="true" />Save this Mass</a
        >
        <a href="/calendar"
          >Chapel calendar <FaArrowRight aria-hidden="true" /></a
        >
      </div>
    </section>

    <section
      class="regular-gathering"
      aria-labelledby="regular-gathering-title"
    >
      <p class="eyebrow">Our weekly rhythm</p>
      <h3 id="regular-gathering-title">Every Sunday</h3>
      <p class="regular-time">
        <time datetime="15:30">3:30 <span>PM</span></time>
      </p>
      <p>Set aside an afternoon.<br />Make room for prayer.</p>
      <div class="schedule-exception">
        <strong>A different rhythm in December</strong>
        <p>
          On Sundays during Simbang Gabi (December 15–23), Mass is at <strong
            >7:30 PM only</strong
          >. There is no 3:30 PM Mass on those Sundays.
        </p>
      </div>
    </section>
  </div>

  <section class="seasonal-schedule" aria-labelledby="seasonal-schedule-title">
    <div class="seasonal-heading">
      <p class="eyebrow">Gather in joyful expectation</p><h2
        id="seasonal-schedule-title"
      >
        Advent & Christmas
      </h2>
    </div>
    <div class="seasonal-dates">
      <article>
        <p class="seasonal-date">December <strong>15–23</strong></p>
        <div>
          <h3>Simbang Gabi</h3><p>
            Misa de Aguinaldo · Nine evenings of prayer
          </p>
        </div>
        <p class="seasonal-time">
          <time datetime="19:30">7:30 PM</time><span>Each evening</span>
        </p>
      </article>
      <article>
        <p class="seasonal-date">December <strong>24</strong></p>
        <div>
          <h3>Christmas Eve Mass</h3><p>Celebrate the Nativity of the Lord</p>
        </div>
        <p class="seasonal-time">
          <time datetime="19:30">7:30 PM</time><span>Christmas Eve</span>
        </p>
      </article>
    </div>
  </section>

  <nav class="mass-preparation" aria-label="Prepare for Mass">
    <p>Before we gather<span>Take a moment to prepare.</span></p>
    <a href="/readings"
      ><FaBookOpen aria-hidden="true" /><span>Reflect on the readings</span
      ><FaArrowRight aria-hidden="true" /></a
    >
    <a href="/songs"
      ><FaMusic aria-hidden="true" /><span>Learn the songs</span><FaArrowRight
        aria-hidden="true"
      /></a
    >
  </nav>
  <p class="schedule-footnote">
    All times are Philippine Time (PHT). For changes and special celebrations,
    check the <a href="/calendar">calendar</a> and <a href="/news"
      >News and Announcements</a
    >.
  </p>
</div>

<script>
  import { prepareHomeBulletin } from "@/lib/home-bulletin-client";
  prepareHomeBulletin();
  document.addEventListener("astro:page-load", () => prepareHomeBulletin());
</script>

<style>
  .mass-experience {
    --mass-ink: #213b4b;
    --mass-paper: #f5f2eb;
    --mass-line: #d7d9d5;
    --mass-muted: #4d626c;
    color: var(--mass-ink);
    font-family: var(--font-primary);
    font-size: 19px;
    line-height: 1.6;
    padding-bottom: 1rem;
  }
  :global(.dark) .mass-experience {
    --mass-ink: #eef2f0;
    --mass-paper: #1c2c36;
    --mass-line: #43545c;
    --mass-muted: #c4d1d5;
  }
  .mass-experience [hidden] {
    display: none !important;
  }
  .mass-experience p,
  .mass-experience h2,
  .mass-experience h3 {
    margin: 0;
  }
  .mass-experience h2,
  .mass-experience h3 {
    font-family: var(--font-secondary);
    font-weight: 400;
    color: inherit;
  }
  .mass-experience a {
    color: inherit;
    text-decoration: none;
  }
  .mass-experience a:focus-visible {
    outline: 3px solid #b58b41;
    outline-offset: 5px;
  }
  .mass-experience a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .mass-experience .eyebrow {
    font-size: 13px;
    font-weight: 650;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .mass-introduction {
    padding: 0.25rem 0 2.25rem;
  }
  .mass-introduction .eyebrow {
    color: var(--mass-muted);
  }
  .mass-introduction h2 {
    font-size: clamp(36px, 4.5vw, 60px);
    line-height: 1.08;
    margin: 0.8rem 0 1rem;
  }
  .mass-introduction > p:last-child {
    max-width: 42rem;
    color: var(--mass-muted);
  }
  .gathering-spread {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    border-radius: 1rem;
    overflow: hidden;
    border: 1px solid var(--mass-line);
  }
  .next-celebration {
    display: flex;
    flex-direction: column;
    background: #163d53;
    color: #fff9ed;
    padding: clamp(1.5rem, 3.5vw, 3rem);
  }
  .panel-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    color: #e7cf9b;
  }
  .panel-top > span {
    font-size: 30px;
  }
  .next-celebration h3 {
    font-size: clamp(27px, 3vw, 37px);
    line-height: 1.2;
    margin: 1.5rem 0 0.75rem;
  }
  .celebration-date {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    font-size: 19px;
  }
  .celebration-time {
    display: block;
    font-family: var(--font-secondary);
    font-size: clamp(54px, 7vw, 92px);
    line-height: 1.1;
    letter-spacing: -0.035em;
    margin-top: 1.25rem;
  }
  .time-zone {
    color: #d3e1e7;
    font-size: 16px;
  }
  .next-celebration .celebration-location {
    color: #d3e1e7;
    margin: 1.5rem 0;
  }
  .celebration-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.25rem;
    padding-top: 1.5rem;
    border-top: 1px solid #547384;
    margin-top: auto;
  }
  .celebration-actions a {
    display: inline-flex;
    gap: 0.6rem;
    align-items: center;
    font-size: 17px;
    padding-block: 0.5rem;
  }
  .celebration-actions .save-mass {
    background: #f0ddb4;
    color: #17374a;
    border-radius: 0.3rem;
    padding: 0.65rem 0.85rem;
    font-weight: 600;
  }
  .mass-experience :global(svg) {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }
  .regular-gathering {
    background: var(--mass-paper);
    padding: clamp(1.5rem, 3.5vw, 3rem);
  }
  .regular-gathering h3 {
    font-size: 37px;
    line-height: 1.2;
    margin-top: 1.25rem;
  }
  .regular-gathering .regular-time {
    font-family: var(--font-secondary);
    font-size: 68px;
    line-height: 1.2;
    margin: 0.5rem 0 1rem;
  }
  .regular-time span {
    font-size: 32px;
  }
  .schedule-exception {
    border-top: 1px solid var(--mass-line);
    padding-top: 1.25rem;
    margin-top: 1.75rem;
    font-size: 17px;
    line-height: 1.6;
  }
  .schedule-exception > strong {
    display: block;
    margin-bottom: 0.5rem;
  }
  .seasonal-schedule {
    margin-top: 3rem;
  }
  .seasonal-heading {
    padding-bottom: 1.25rem;
  }
  .seasonal-heading .eyebrow {
    color: var(--mass-muted);
  }
  .seasonal-heading h2 {
    font-size: 36px;
    line-height: 1.25;
    margin-top: 0.4rem;
  }
  .seasonal-dates article {
    display: grid;
    grid-template-columns: 145px 1fr auto;
    gap: 1.5rem;
    align-items: center;
    border-top: 1px solid var(--mass-line);
    padding-block: 1.5rem;
  }
  .seasonal-dates article:last-child {
    border-bottom: 1px solid var(--mass-line);
  }
  .seasonal-date {
    display: flex;
    flex-direction: column;
    font-size: 16px;
  }
  .seasonal-date strong {
    font-family: var(--font-secondary);
    font-size: 38px;
    font-weight: 400;
    line-height: 1.1;
  }
  .seasonal-dates h3 {
    font-size: 28px;
    line-height: 1.25;
    margin-bottom: 0.25rem;
  }
  .seasonal-dates article > div p {
    font-size: 17px;
    color: var(--mass-muted);
  }
  .seasonal-time {
    text-align: right;
    white-space: nowrap;
  }
  .seasonal-time time {
    font-size: 23px;
    font-weight: 600;
  }
  .seasonal-time span {
    display: block;
    font-size: 15px;
    color: var(--mass-muted);
  }
  .mass-preparation {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 1.5rem;
    padding: 1.5rem;
    background: var(--mass-paper);
    margin-top: 2.5rem;
    border-radius: 0.5rem;
  }
  .mass-preparation > p {
    font-family: var(--font-secondary);
    font-size: 26px;
    line-height: 1.25;
  }
  .mass-preparation > p span {
    display: block;
    font-family: var(--font-primary);
    font-size: 16px;
    color: var(--mass-muted);
    margin-top: 0.4rem;
  }
  .mass-preparation a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 17px;
    min-height: 44px;
  }
  .mass-preparation a :global(svg:last-child) {
    width: 12px;
    margin-left: auto;
  }
  .mass-experience .schedule-footnote {
    font-size: 16px;
    color: var(--mass-muted);
    margin-top: 1.25rem;
  }
  .schedule-footnote a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 760px) {
    .gathering-spread {
      grid-template-columns: 1fr;
    }
    .next-celebration,
    .regular-gathering {
      padding: 1.5rem;
    }
    .celebration-time {
      font-size: clamp(50px, 13vw, 76px);
    }
    .seasonal-dates article {
      grid-template-columns: 85px 1fr;
      gap: 1rem;
    }
    .seasonal-time {
      grid-column: 2;
      text-align: left;
    }
    .seasonal-time span {
      display: inline;
      margin-left: 0.5rem;
    }
    .mass-preparation {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .mass-preparation a {
      border-top: 1px solid var(--mass-line);
      padding-top: 1rem;
    }
  }
</style>
